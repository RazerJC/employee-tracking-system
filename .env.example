# TAASCOR Attendance Monitoring System - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MySQL / MariaDB database for this environment
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
DB_SSL=false
# Optional CA certificate file when the database requires TLS
# DB_SSL_CA=/path/to/ca.pem

# Session
SESSION_SECRET=

# Initial Admin (only used on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP (for email verification and password recovery)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# App URL (used in email links)
APP_URL=http://localhost:3000

# Timezone
TZ=Asia/Manila
