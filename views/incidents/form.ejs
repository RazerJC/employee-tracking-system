<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>File Incident Report</h2>
        <div class="breadcrumb">
            <a href="/incidents">Incident Management</a>
            <span>/</span>
            <span>New Report</span>
        </div>
    </div>
</div>

<div style="max-width: 860px; margin: 0 auto;">
    <div class="card" style="background: white; border-radius: 14px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); padding: 28px; border: 1px solid #e2e8f0;">
        
        <div style="background: #fffbeb; border-left: 4px solid #f59e0b; padding: 14px 18px; border-radius: 6px; margin-bottom: 24px;">
            <div style="font-weight: 700; color: #92400e; font-size: 0.95rem; margin-bottom: 2px;">
                ⚠️ Incident Transparency & Prompt Reporting
            </div>
            <div style="color: #78350f; font-size: 0.85rem; line-height: 1.4;">
                This incident report will be immediately transmitted directly to HR and Executive Administration. Please provide objective, accurate facts, including any actions you immediately took on the ground.
            </div>
        </div>

        <form action="/incidents" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 18px;">
                <div class="form-group">
                    <label for="area_id" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                        Warehouse / Work Area <span style="color: #ef4444;">*</span>
                    </label>
                    <% if (user.role === 'COORDINATOR') { %>
                        <input type="hidden" name="area_id" value="<%= userAreaId %>">
                        <input type="text" class="form-control" value="<%= userArea ? userArea.name : 'Your Assigned Area' %>" readonly disabled style="background: #f8fafc; font-weight: 600;">
                    <% } else { %>
                        <select id="area_id" name="area_id" class="form-control" required>
                            <% areas.forEach(a => { %>
                                <option value="<%= a.id %>" <%= selectedAreaId === a.id ? 'selected' : '' %>><%= a.name %></option>
                            <% }) %>
                        </select>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="employee_id" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                        Personnel Involved (Optional / If Applicable)
                    </label>
                    <select id="employee_id" name="employee_id" class="form-control">
                        <option value="">-- General Facility / Multiple Workers / Other --</option>
                        <% if (employees && employees.length > 0) { %>
                            <% employees.forEach(e => { %>
                                <option value="<%= e.id %>"><%= e.full_name %> (<%= e.employee_id %>)</option>
                            <% }) %>
                        <% } %>
                    </select>
                    <div style="font-size: 0.75rem; color: #64748b; margin-top: 3px;">Select specific worker if the incident concerns a specific person.</div>
                </div>
            </div>

            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 18px;">
                <div class="form-group">
                    <label for="incident_date" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                        Date of Incident <span style="color: #ef4444;">*</span>
                    </label>
                    <input type="date" id="incident_date" name="incident_date" class="form-control"
                           value="<%= DateTime.now().setZone('Asia/Manila').toISODate() %>" required>
                </div>

                <div class="form-group">
                    <label for="incident_time" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                        Approximate Time (HH:MM)
                    </label>
                    <input type="time" id="incident_time" name="incident_time" class="form-control"
                           value="<%= DateTime.now().setZone('Asia/Manila').toFormat('HH:mm') %>">
                </div>
            </div>

            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 18px;">
                <div class="form-group">
                    <label for="category" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                        Incident Classification <span style="color: #ef4444;">*</span>
                    </label>
                    <select id="category" name="category" class="form-control" required>
                        <option value="safety_injury">🦺 Workplace Safety & Physical Injury</option>
                        <option value="disciplinary_misconduct">⚖️ Disciplinary & Worker Misconduct</option>
                        <option value="damage_loss">📦 Property Damage & Equipment Breakdown</option>
                        <option value="health_medical">🏥 Health, Medical Emergency & Illness</option>
                        <option value="behavioral_dispute">🗣️ Behavioral Dispute, Altercation & Harassment</option>
                        <option value="attendance_violation">🚪 Unannounced Walkout, Abandonment & AWOL</option>
                        <option value="theft_security">🚨 Theft, Pilferage & Security Breach</option>
                        <option value="other">📌 Other Ground Operational Concern</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="severity" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                        Severity Rating <span style="color: #ef4444;">*</span>
                    </label>
                    <select id="severity" name="severity" class="form-control" required>
                        <option value="minor">🔵 Minor (Internal logging / slight delay / minor dispute)</option>
                        <option value="moderate" selected>🟡 Moderate (Operations affected / formal sanction needed)</option>
                        <option value="major">🟠 Major (Significant damage / severe misconduct / clinic visit)</option>
                        <option value="critical">🔴 Critical (Hospitalization / violence / criminal act / immediate HR halt)</option>
                    </select>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label for="title" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                    Incident Headline / Title <span style="color: #ef4444;">*</span>
                </label>
                <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Worker slipped on wet aisle in Loading Dock B; minor sprain" required>
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label for="location_details" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                    Exact Specific Location in Warehouse
                </label>
                <input type="text" id="location_details" name="location_details" class="form-control" placeholder="e.g. Inbound Staging Bay 4, Near Forklift Battery Charging Station">
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label for="description" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                    Full Statement of What Happened <span style="color: #ef4444;">*</span>
                </label>
                <textarea id="description" name="description" class="form-control" rows="5" placeholder="Detailed chronological sequence of events, persons present, witnesses, conditions at the scene, and factual statements..." required></textarea>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
                <label for="immediate_action_taken" style="font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px; display: block;">
                    Immediate Action Taken by Coordinator / Ground Staff
                </label>
                <textarea id="immediate_action_taken" name="immediate_action_taken" class="form-control" rows="3" placeholder="e.g. Brought worker to first aid station; cordoned off area; pacified altercation and separated parties; called supervisor..."></textarea>
            </div>

            <div style="display: flex; gap: 12px; align-items: center;">
                <button type="submit" class="btn btn-primary btn-lg" style="padding: 12px 28px; font-weight: 700;">
                    🚀 Submit Incident Report
                </button>
                <a href="/incidents" class="btn btn-outline btn-lg" style="padding: 12px 24px;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/layout-bottom') %>
