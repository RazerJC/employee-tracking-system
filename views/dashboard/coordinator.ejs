<%- include('../partials/layout-top') %>

<%- include('../partials/dashboard-hero', {
    eyebrow: 'Daily attendance and coordination',
    headline: 'Your team, ready for every working day.',
    description: 'Manage daily attendance, employee schedules, return-to-work clearances, and staffing requests in one connected workspace.',
    contextTitle: typeof userArea !== 'undefined' && userArea ? userArea.name : 'Area assignment pending',
    contextText: typeof today !== 'undefined' ? 'Your assigned workplace · ' + formatDate(today) + ' · Asia/Manila' : 'Your warehouse assignment will appear here once it is approved by HR.'
}) %>

<% if (typeof noArea !== 'undefined' && noArea) { %>
    <div class="alert alert-warning">
        <span class="alert-icon">⚠️</span>
        <div>Your coordinator account is active, but you have not yet been assigned to an area/warehouse by HR. Please contact the HR department.</div>
    </div>
<% } else { %>

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card">
            <div class="card-icon green"><%- include('../partials/outline-icon', {icon:'check'}) %></div>
            <div class="card-data">
                <h4><%= presentCount %></h4>
                <p>Present Today</p>
            </div>
        </div>

        <div class="summary-card">
            <div class="card-icon red"><%- include('../partials/outline-icon', {icon:'close'}) %></div>
            <div class="card-data">
                <h4><%= absentCount %></h4>
                <p>Absent Today</p>
            </div>
        </div>

        <div class="summary-card">
            <div class="card-icon yellow"><%- include('../partials/outline-icon', {icon:'medical'}) %></div>
            <div class="card-data">
                <h4><%= pendingBtw.length %></h4>
                <p>Pending Back-to-Work</p>
            </div>
        </div>

        <div class="summary-card">
            <div class="card-icon blue"><%- include('../partials/outline-icon', {icon:'people'}) %></div>
            <div class="card-data">
                <h4><%= manpowerRequests.length %></h4>
                <p>Active Manpower Requests</p>
            </div>
        </div>
    </div>

    <%- include('../partials/dashboard-shortcuts', { shortcuts: [
        { href: '/attendance?date=' + today, label: 'Mark attendance' },
        { href: '/employees/new', label: 'Add employee' },
        { href: '/manpower/new', label: 'Request manpower' },
        { href: '/concerns/new', label: 'Report concern' }
    ] }) %>

    <!-- Coordinator's Own Attendance Status -->
    <div class="card mb-3" style="border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div class="card-header" style="background: linear-gradient(135deg, #1b2a4a 0%, #2a437c 100%); color: #ffffff; border-top-left-radius: 12px; border-top-right-radius: 12px; padding: 14px 20px;">
            <h3 style="margin: 0; color: #ffffff; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;">
                <span>⏱️</span>
                <span>My Daily Attendance</span>
            </h3>
            <span style="color: rgba(255,255,255,0.8); font-size: 0.85rem;"><%= formatDate(today) %></span>
        </div>
        <div class="card-body" style="padding: 18px 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                <div>
                    <% if (!ownAttendance) { %>
                        <p style="color: var(--color-gray-600); font-size: 0.9rem; margin: 0 0 6px 0;">
                            You have not timed in for today's shift yet. Click <strong>Camera Time-In</strong> below to take your photo.
                        </p>
                    <% } else { %>
                        <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span style="font-size: 0.85rem; color: #64748b;">Time-In:</span>
                                <strong style="color: var(--color-success); font-size: 1.05rem;"><%= formatTime(ownAttendance.time_in) %></strong>
                                <% if (ownAttendance.time_in_photo) { %>
                                    <img src="<%= ownAttendance.time_in_photo %>" onclick="openLightbox(this.src)" title="Time-In Photo (Click to zoom)" alt="Time-In Photo" style="width:34px;height:34px;border-radius:6px;object-fit:cover;border:2px solid #059669;cursor:pointer;">
                                <% } %>
                                
                            </div>

                            <% if (ownAttendance.time_out) { %>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 0.85rem; color: #64748b;">• Time-Out:</span>
                                    <strong style="color: var(--color-primary); font-size: 1.05rem;"><%= formatTime(ownAttendance.time_out) %></strong>
                                    <% if (ownAttendance.time_out_photo) { %>
                                        <img src="<%= ownAttendance.time_out_photo %>" onclick="openLightbox(this.src)" title="Time-Out Photo (Click to zoom)" alt="Time-Out Photo" style="width:34px;height:34px;border-radius:6px;object-fit:cover;border:2px solid #2563eb;cursor:pointer;">
                                    <% } %>
                                    
                                </div>
                            <% } else { %>
                                <span class="badge badge-warning" style="padding: 4px 10px; font-weight: 600;">Shift In Progress</span>
                            <% } %>
                        </div>
                    <% } %>
                </div>
                <div class="btn-group" style="display: flex; align-items: center; gap: 10px;">
                    <% if (!ownAttendance) { %>
                        <button type="button" class="btn btn-success" onclick="openWebcam('time-in', '/dashboard')" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; padding: 10px 18px; border-radius: 8px; box-shadow: 0 2px 8px rgba(5,150,105,0.25);">
                            📸 Camera Time-In
                        </button>
                    <% } else if (!ownAttendance.time_out) { %>
                        <button type="button" class="btn btn-primary" onclick="openWebcam('time-out', '/dashboard')" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; padding: 10px 18px; border-radius: 8px; box-shadow: 0 2px 8px rgba(37,99,235,0.25);">
                            📸 Camera Time-Out
                        </button>
                    <% } else { %>
                        <span class="badge badge-success" style="padding: 8px 16px; font-size: 0.88rem; font-weight: 700;">✅ Shift Completed</span>
                    <% } %>
                    <a href="/coordinator-attendance" class="btn btn-outline btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
                        <span>📋</span>
                        <span>Full Log</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 20px;">
        <!-- Needs Your Action List -->
        <div class="card">
            <div class="card-header">
                <h3>⚡ Needs Your Action</h3>
                <span class="badge badge-primary"><%= incomingWorkers.length + pendingBtw.length %></span>
            </div>
            <div class="card-body" style="padding: 0;">
                <% if (incomingWorkers.length === 0 && pendingBtw.length === 0) { %>
                    <div class="empty-state">
                        <p>No urgent pending items for your attention!</p>
                    </div>
                <% } else { %>
                    <ul class="action-list">
                        <!-- Incoming workers awaiting confirmation -->
                        <% incomingWorkers.forEach(w => { %>
                            <li class="action-list-item">
                                <div class="item-info">
                                    <div class="item-title">Confirm Worker Arrival: <%= w.worker_name || w.emp_name %></div>
                                    <div class="item-subtitle">Requested: <%= w.requested_position || 'General' %> • Deployment: <%= formatDate(w.deployment_date) %></div>
                                </div>
                                <a href="/manpower/<%= w.request_id %>" class="btn btn-sm btn-primary">Confirm</a>
                            </li>
                        <% }) %>

                        <!-- Pending BTW cases -->
                        <% pendingBtw.forEach(b => { %>
                            <li class="action-list-item">
                                <div class="item-info">
                                    <div class="item-title">BTW Clearance: <%= b.full_name %> (<%= b.emp_code %>)</div>
                                    <div class="item-subtitle">Ref: <%= b.case_ref %> • Status: <%= b.status.replace(/_/g, ' ') %></div>
                                </div>
                                <a href="/btw/<%= b.id %>" class="btn btn-sm btn-outline">View Case</a>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </div>
        </div>

        <!-- Today's Absences -->
        <div class="card">
            <div class="card-header">
                <h3>❌ Absent Employees Today</h3>
                <span class="badge badge-danger"><%= absentToday.length %></span>
            </div>
            <div class="card-body" style="padding: 0;">
                <% if (absentToday.length === 0) { %>
                    <div class="empty-state">
                        <p>No employees reported absent today.</p>
                    </div>
                <% } else { %>
                    <ul class="action-list">
                        <% absentToday.forEach(emp => { %>
                            <li class="action-list-item">
                                <div class="item-info">
                                    <div class="item-title"><%= emp.full_name %> (<%= emp.employee_id %>)</div>
                                    <div class="item-subtitle">
                                        <%= emp.position_title || 'Worker' %>
                                        <% if (emp.remarks) { %> • <%= emp.remarks %><% } %>
                                    </div>
                                </div>
                                <% if (emp.btw_id) { %>
                                    <a href="/btw/<%= emp.btw_id %>" class="btn btn-sm btn-warning">View Clearance</a>
                                <% } else { %>
                                    <span class="badge badge-secondary">Processing</span>
                                <% } %>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </div>
        </div>
    </div>

<% } %>

<%- include('../partials/attendance-webcam-modal') %>

<%- include('../partials/layout-bottom') %>
