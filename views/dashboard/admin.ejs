<%- include('../partials/layout-top', { pageStylesheet: '/css/admin-overview.css' }) %>

<%
    function dashboardUrl(changes = {}, focusDetails = false) {
        const params = new URLSearchParams();
        if (areaId) params.set('area_id', areaId);
        if (mode === 'coordinator') params.set('by', mode);
        for (const [key, value] of Object.entries(changes)) {
            if (value) params.set(key, value);
            else params.delete(key);
        }
        return '/dashboard' + (params.size ? '?' + params : '') + (focusDetails ? '#overview-detail' : '');
    }
    const pendingBars = pendingCategories.map(category => ({
        label: category.label,
        caption: areaId && category.key === 'accounts' ? 'All warehouses' : '',
        count: pendingCounts[category.path] || 0,
        href: dashboardUrl({ pending: category.key }, true),
        selected: pendingCategory?.key === category.key
    }));
    const workforceBars = workforce.map(group => ({
        label: group.label,
        caption: !areaId && group.area ? group.area : '',
        count: group.count,
        href: dashboardUrl({ group: group.key }, true),
        selected: selectedGroup?.key === group.key
    }));
    const detail = pendingCategory || selectedGroup;
    const drill = { group: selectedGroup?.key, warehouse: warehouses.length > 1 ? selectedWarehouse?.key : null };
    const backUrl = selectedDepartment ? dashboardUrl(drill, true)
        : selectedWarehouse && warehouses.length > 1 ? dashboardUrl({ group: selectedGroup.key }, true)
        : dashboardUrl();
    const categoryUrl = pendingCategory
        ? pendingCategory.path + (pendingCategory.filter || '') + (areaId && pendingCategory.filter ? '&area_id=' + areaId : '')
        : null;
%>

<section class="admin-overview">
    <div class="admin-overview-heading">
        <h2>Admin Overview</h2>
        <% if (!detail) { %>
        <form class="admin-overview-filter" method="GET" action="/dashboard">
            <% if (mode === 'coordinator') { %><input type="hidden" name="by" value="coordinator"><% } %>
            <label for="overview-warehouse">Warehouse</label>
            <select id="overview-warehouse" name="area_id" class="form-control">
                <option value="">All warehouses</option>
                <% areas.forEach(area => { %>
                    <option value="<%= area.id %>" <%= area.id === areaId ? 'selected' : '' %>><%= area.name %></option>
                <% }); %>
            </select>
            <button type="submit" class="btn btn-sm btn-outline">Apply</button>
        </form>
        <% } %>
    </div>

    <% if (!detail) { %>
    <div class="admin-overview-grid">
        <section class="admin-chart admin-pending-chart" aria-labelledby="pending-chart-title">
            <header class="admin-chart-heading">
                <h3 id="pending-chart-title">Pending Work</h3>
                <strong><%= pendingBars.reduce((total, bar) => total + bar.count, 0) %></strong>
            </header>
            <%- include('admin-bars', { bars: pendingBars }) %>
        </section>

        <section class="admin-chart admin-workforce-chart" aria-labelledby="workforce-chart-title">
            <header class="admin-chart-heading">
                <h3 id="workforce-chart-title">Workforce</h3>
                <strong><%= workforce.reduce((total, group) => total + group.count, 0) %> <small>active</small></strong>
            </header>
            <nav class="admin-chart-switch" aria-label="Group workforce by">
                <a href="<%= dashboardUrl({ by: 'department', group: areaId }, Boolean(areaId)) %>" <%= mode === 'department' ? 'aria-current=true' : '' %>>By Department</a>
                <a href="<%= dashboardUrl({ by: 'coordinator' }) %>" <%= mode === 'coordinator' ? 'aria-current=true' : '' %>>By Coordinator</a>
            </nav>
            <%- include('admin-bars', { bars: workforceBars }) %>
        </section>

    </div>
    <div class="admin-deployment-summary" style="margin-top: 18px;">
        <%- include('../partials/manpower-dashboard') %>
    </div>
    <% } else { %>
            <section class="admin-chart admin-overview-detail" id="overview-detail" tabindex="-1" aria-labelledby="overview-detail-title">
                <a class="btn btn-sm btn-outline admin-overview-back" href="<%= backUrl %>">← Back</a>
                <header class="admin-chart-heading">
                    <h3 id="overview-detail-title"><%= selectedDepartment?.label || detail.label %></h3>
                </header>
                <% if (pendingCategory) { %>
                    <% if (!pendingRecords.length) { %><p class="admin-chart-empty">No pending items in this category.</p><% } %>
                    <ul class="admin-detail-list">
                        <% pendingRecords.forEach(record => { %>
                            <li>
                                <div>
                                    <a href="<%= pendingCategory.key === 'accounts' ? categoryUrl : pendingCategory.path + '/' + record.id %>"><%= record.title %></a>
                                    <small><%= record.area_name || 'All warehouses' %></small>
                                </div>
                                <%- include('../partials/status-badge', { status: record.status }) %>
                            </li>
                        <% }); %>
                    </ul>
                    <% if (pendingCounts[pendingCategory.path] > pendingRecords.length) { %><p>Showing the latest <%= pendingRecords.length %> records.</p><% } %>
                    <a class="admin-detail-link" href="<%= categoryUrl %>">View category</a>
                <% } else { %>
                    <% if (selectedDepartment) { %>
                        <p class="admin-detail-meta"><%= selectedWarehouse.label %><%= mode === 'coordinator' ? ' · ' + selectedGroup.label : '' %> · <%= assignedWorkers.length %> active workers</p>
                        <% if (!assignedWorkers.length) { %><p class="admin-chart-empty">No active workers in this department.</p><% } %>
                        <ul class="admin-detail-list">
                            <% assignedWorkers.forEach(worker => { %>
                                <li><div>
                                    <a href="/employees/<%= worker.id %>"><%= worker.full_name %></a>
                                    <% if (mode === 'department') { %><small><%= worker.coordinator_name || 'Unassigned Coordinator' %></small><% } %>
                                </div></li>
                            <% }); %>
                        </ul>
                    <% } else if (selectedWarehouse) { %>
                        <h4 class="admin-detail-workers-heading">Departments<%= mode === 'coordinator' ? ' · ' + selectedWarehouse.label : '' %></h4>
                        <%- include('admin-bars', { bars: departmentGroups.map(department => ({
                            ...department, href: dashboardUrl({ ...drill, department: department.key }, true)
                        })) }) %>
                    <% } else { %>
                        <h4 class="admin-detail-workers-heading">Warehouses</h4>
                        <%- include('admin-bars', { bars: warehouses.map(warehouse => ({
                            ...warehouse, href: dashboardUrl({ group: selectedGroup.key, warehouse: warehouse.key }, true)
                        })) }) %>
                    <% } %>
                    <% if (selectedGroup.href) { %><a class="admin-detail-link" href="<%= selectedGroup.href %>">View coordinator profile</a><% } %>
                <% } %>
            </section>
    <% } %>
</section>

<%- include('../partials/layout-bottom') %>
