<!-- ── TAASCOR ATTENDANCE CAMERA (LIGHTWEIGHT, FAST & OFFICIAL TAASCOR BRANDING) ── -->
<style>
.webcam-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.82);
    z-index: 2000;
    align-items: center;
    justify-content: center;
}
.webcam-modal-overlay.active {
    display: flex;
}
.webcam-modal {
    background: #ffffff;
    border-radius: 18px;
    width: 92%;
    max-width: 480px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    animation: modalPop 0.18s ease-out;
}
@keyframes modalPop {
    from { transform: scale(0.95); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
}
.webcam-modal-header {
    background: linear-gradient(135deg, #1b2a4a 0%, #243b6b 100%);
    border-bottom: 3px solid #f59e0b;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.webcam-header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
}
.webcam-header-logo {
    height: 36px;
    width: auto;
    object-fit: contain;
    background: #ffffff;
    border-radius: 6px;
    padding: 2px 4px;
}
.webcam-header-titles {
    display: flex;
    flex-direction: column;
}
.webcam-header-company {
    font-size: 0.72rem;
    font-weight: 800;
    color: #fbbf24;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    line-height: 1.1;
}
.webcam-header-mode {
    font-size: 0.98rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
}
.webcam-close-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    color: #ffffff;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
}
.webcam-close-btn:hover { background: rgba(255,255,255,0.3); }

.webcam-modal-body { padding: 16px 18px 18px; }

/* Clean, super-lightweight camera preview (GPU-accelerated, NO lag) */
.camera-preview-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: #000000;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
}
#cameraVideo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
    display: block;
}
#cameraCanvas { display: none; }

/* Subtle lightweight guide (NO heavy filters/tickers) */
.camera-face-guide {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52%;
    aspect-ratio: 3/4;
    border: 2px dashed rgba(255, 255, 255, 0.75);
    border-radius: 50%;
    pointer-events: none;
}

/* Captured photo preview */
#capturedPhotoWrap {
    display: none;
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
    background: #000000;
}
#capturedPhotoPreview {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.photo-confirmed-badge {
    position: absolute;
    top: 10px;
    right: 12px;
    background: #059669;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Status message */
.camera-status {
    padding: 9px 12px;
    border-radius: 8px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    font-size: 0.83rem;
    color: #334155;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
}
.camera-status.error {
    background: #fef2f2;
    border-color: #fecaca;
    color: #b91c1c;
}
.camera-status.success {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #15803d;
}

/* Action buttons */
.webcam-btn-row {
    display: flex;
    gap: 10px;
}
.btn-capture {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #1b2a4a 0%, #2d4a8a 100%);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.15s, background 0.15s;
    box-shadow: 0 4px 12px rgba(27, 42, 74, 0.2);
}
.btn-capture:hover:not(:disabled) {
    background: linear-gradient(135deg, #2d4a8a 0%, #1b2a4a 100%);
    transform: translateY(-1px);
}
.btn-capture:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.btn-retake {
    flex: 1;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #ffffff;
    color: #475569;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s;
}
.btn-retake:hover { background: #f8fafc; }

.btn-submit-punch {
    flex: 2;
    padding: 12px;
    border: none;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.92rem;
    color: #ffffff;
    cursor: pointer;
    transition: transform 0.15s;
}
.btn-submit-punch:hover { transform: translateY(-1px); }
.btn-submit-punch.in {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    box-shadow: 0 4px 12px rgba(5,150,105,0.25);
}
.btn-submit-punch.out {
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    box-shadow: 0 4px 12px rgba(37,99,235,0.25);
}
.btn-submit-punch:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

/* Lightbox */
.photo-lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.88);
    z-index: 2000;
    align-items: center;
    justify-content: center;
}
.photo-lightbox-overlay.active { display: flex; }
.photo-lightbox-img {
    max-width: 90vw;
    max-height: 82vh;
    border-radius: 12px;
    object-fit: contain;
}
.photo-lightbox-close {
    position: fixed;
    top: 20px;
    right: 24px;
    background: rgba(255,255,255,0.2);
    border: none;
    color: #fff;
    font-size: 1.6rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
}
</style>

<!-- MODAL MARKUP -->
<div class="webcam-modal-overlay" id="webcamModalOverlay">
    <div class="webcam-modal">
        <div class="webcam-modal-header">
            <div class="webcam-header-brand">
                <img src="/images/taascor-official-logo.png" alt="TAASCOR" class="webcam-header-logo">
                <div class="webcam-header-titles">
                    <span class="webcam-header-company">TAASCOR MANAGEMENT</span>
                    <h4 class="webcam-header-mode" id="webcamModalTitle">📸 Camera Time-In</h4>
                </div>
            </div>
            <button type="button" class="webcam-close-btn" onclick="closeWebcam()">✕</button>
        </div>
        <div class="webcam-modal-body">

            <!-- Clean, lightweight camera preview (30fps native stream) -->
            <div class="camera-preview-wrap" id="cameraPreviewWrap">
                <video id="cameraVideo" autoplay playsinline muted></video>
                <canvas id="cameraCanvas"></canvas>
                <div class="camera-face-guide"></div>
            </div>

            <!-- Captured Photo Preview -->
            <div id="capturedPhotoWrap">
                <img id="capturedPhotoPreview" src="" alt="Captured verification photo">
                <div class="photo-confirmed-badge">✓ Photo Captured</div>
            </div>

            <!-- Camera Status Message -->
            <div class="camera-status" id="cameraStatus" role="status">
                <span>🎥</span>
                <span>Live Camera Active — Align face within guide and tap Capture</span>
            </div>

            <!-- Single Capture Button Step (Standard & Clean) -->
            <div id="captureStepWrap">
                <div class="webcam-btn-row" id="captureRow">
                    <button type="button" class="btn-capture" id="captureBtn" onclick="capturePhoto()">
                        📸 Capture Photo
                    </button>
                    <button type="button" class="btn-retake" id="retryCameraBtn" onclick="startWebcamCamera()" hidden>Retry camera</button>
                </div>
            </div>

            <!-- Confirm & Retake Step -->
            <div class="webcam-btn-row" id="confirmRow" style="display: none;">
                <button type="button" class="btn-retake" onclick="retakePhoto()">
                    🔄 Retake
                </button>
                <button type="button" class="btn-submit-punch" id="submitPunchBtn" onclick="submitPunch()">
                    ✅ Confirm & Record
                </button>
            </div>

            <!-- Hidden Submit Forms (Silent GPS sent to Head HR only) -->
            <form id="sharedTimeInForm" action="/coordinator-attendance/time-in" method="POST" style="display:none;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="return_to" id="timeInReturnTo" value="">
                <input type="hidden" name="time_in_photo" id="timeInPhotoHidden">
                <input type="hidden" name="lat" id="timeInLat">
                <input type="hidden" name="lng" id="timeInLng">
                <input type="hidden" name="accuracy" id="timeInAccuracy">
                <input type="hidden" name="location_address" id="timeInLocation">
            </form>
            <form id="sharedTimeOutForm" action="/coordinator-attendance/time-out" method="POST" style="display:none;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="return_to" id="timeOutReturnTo" value="">
                <input type="hidden" name="time_out_photo" id="timeOutPhotoHidden">
                <input type="hidden" name="lat" id="timeOutLat">
                <input type="hidden" name="lng" id="timeOutLng">
                <input type="hidden" name="accuracy" id="timeOutAccuracy">
                <input type="hidden" name="location_address" id="timeOutLocation">
            </form>
        </div>
    </div>
</div>

<!-- PHOTO LIGHTBOX -->
<div class="photo-lightbox-overlay" id="photoLightbox" onclick="closeLightbox()">
    <button type="button" class="photo-lightbox-close" onclick="closeLightbox()">✕</button>
    <img class="photo-lightbox-img" id="lightboxImg" src="" alt="Punch photo">
</div>

<script>
// Server Context
window.TAASCOR_USER_NAME = "<%= (typeof user !== 'undefined' && user && user.full_name) ? user.full_name.replace(/["\\]/g, '') : 'Staff' %>";
window.TAASCOR_USER_ROLE = "<%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'COORDINATOR' %>";
window.TAASCOR_DEFAULT_AREA = "<%= (typeof userArea !== 'undefined' && userArea && userArea.name) ? userArea.name.replace(/["\\]/g, '') : 'Assigned Warehouse' %>";

let activeWebcamStream = null;
let currentWebcamMode = 'time-in';
let activeCapturedDataUri = null;
let currentReturnUrl = window.location.pathname;

let capturedLocation = null;
let captureRevision = 0;

let cameraRevision = 0;
let gpsWatch = null;
let locationRevision = 0;
let latestPosition = null;
const gpsOptions = { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 };

function stopLiveLocation() {
    locationRevision++;
    if (gpsWatch !== null) navigator.geolocation.clearWatch(gpsWatch);
    gpsWatch = null;
    latestPosition = null;
}

function startLiveLocation() {
    stopLiveLocation();
    if (!navigator.geolocation) return;
    const revision = locationRevision;
    gpsWatch = navigator.geolocation.watchPosition(position => {
        if (gpsWatch !== null && revision === locationRevision) latestPosition = position;
    }, () => {}, gpsOptions);
}

async function readCaptureLocation(capturedAt) {
    const recent = latestPosition && Math.abs(capturedAt.getTime() - latestPosition.timestamp) <= 8000;
    const position = recent ? latestPosition : await new Promise(resolve => {
        if (!navigator.geolocation) return resolve(null);
        const timer = setTimeout(() => resolve(null), gpsOptions.timeout);
        const finish = value => {
            clearTimeout(timer);
            resolve(value);
        };
        navigator.geolocation.getCurrentPosition(finish, () => finish(null), gpsOptions);
    }).catch(() => null);
    if (!position || Math.abs(capturedAt.getTime() - position.timestamp) > 8000) return null;
    return {
        lat: position.coords.latitude.toFixed(6),
        lng: position.coords.longitude.toFixed(6),
        accuracy: Math.round(position.coords.accuracy)
    };
}

function getManilaDatetime(now) {
    const options = { timeZone: 'Asia/Manila' };

    const year   = now.toLocaleString('en-US', { ...options, year: 'numeric' });
    const month  = now.toLocaleString('en-US', { ...options, month: '2-digit' });
    const day    = now.toLocaleString('en-US', { ...options, day: '2-digit' });
    const hour   = now.toLocaleString('en-US', { ...options, hour: '2-digit', hourCycle: 'h23' });
    const minute = now.toLocaleString('en-US', { ...options, minute: '2-digit' });
    const second = now.toLocaleString('en-US', { ...options, second: '2-digit' });

    const hh = hour.padStart(2, '0');
    const mm = minute.padStart(2, '0');
    const ss = second.padStart(2, '0');

    const dateStr = `${month}/${day}/${year}`;
    const timeStr = `${hh}:${mm}:${ss}`;
    const dayOfWeek = now.toLocaleString('en-US', { ...options, weekday: 'short' }).toUpperCase();

    return { dateStr, timeStr, dayOfWeek };
}

// ── TAASCOR BRANDED WATERMARK (Drawn onto captured photo for Head HR) ──
function drawTaascorWatermark(ctx, canvasWidth, canvasHeight, capturedAt, location) {
    const dt = getManilaDatetime(capturedAt);
    const locationText = location
        ? `GPS: ${location.lat}, ${location.lng}  ±${location.accuracy} m`
        : 'GPS unavailable';

    const barHeight = Math.max(74, Math.round(canvasHeight * 0.18));
    const startY = canvasHeight - barHeight;

    ctx.save();
    // TAASCOR Navy Blue background
    ctx.fillStyle = 'rgba(27, 42, 74, 0.94)';
    ctx.fillRect(0, startY, canvasWidth, barHeight);

    // TAASCOR Gold Accent Line
    ctx.fillStyle = '#f59e0b';
    ctx.fillRect(0, startY, canvasWidth, 3);

    const normalSize = Math.max(10, Math.min(13, Math.round(canvasWidth * 0.022)));
    const titleSize  = Math.max(12, Math.min(15, Math.round(canvasWidth * 0.026)));

    const leftMargin = 14;
    let lineY = startY + 16;

    // Line 1: Company Name & Time
    ctx.font = 'bold ' + titleSize + 'px sans-serif';
    ctx.fillStyle = '#fbbf24';
    ctx.textAlign = 'left';
    ctx.fillText('TAASCOR', leftMargin, lineY);

    ctx.textAlign = 'right';
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold ' + normalSize + 'px monospace';
    ctx.fillText(dt.timeStr + ' PHT', canvasWidth - leftMargin, lineY);

    // Line 2: Staff name & Area
    lineY += normalSize + 6;
    ctx.font = 'bold ' + normalSize + 'px sans-serif';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#ffffff';
    ctx.fillText(`${window.TAASCOR_USER_NAME} | ${window.TAASCOR_DEFAULT_AREA}`, leftMargin, lineY, Math.max(1, canvasWidth - 150));

    ctx.textAlign = 'right';
    ctx.fillStyle = '#fbbf24';
    ctx.fillText(`${dt.dateStr} (${dt.dayOfWeek})`, canvasWidth - leftMargin, lineY);

    // Line 3: Location (Burnt into photo for Head HR verification)
    lineY += normalSize + 5;
    ctx.font = 'normal ' + (normalSize - 1) + 'px sans-serif';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#93c5fd';
    ctx.fillText(locationText, leftMargin, lineY, canvasWidth - 2 * leftMargin);

    ctx.restore();
}

function openWebcam(mode, returnUrl) {
    currentWebcamMode = mode || 'time-in';
    currentReturnUrl = returnUrl || window.location.pathname;
    activeCapturedDataUri = null;
    capturedLocation = null;
    captureRevision++;

    const titleEl = document.getElementById('webcamModalTitle');
    const submitBtn = document.getElementById('submitPunchBtn');

    if (mode === 'time-in') {
        titleEl.textContent = '📸 Camera Time-In';
        submitBtn.className = 'btn-submit-punch in';
        submitBtn.textContent = '✅ Confirm & Record Time-In';
    } else {
        titleEl.textContent = '📸 Camera Time-Out';
        submitBtn.className = 'btn-submit-punch out';
        submitBtn.textContent = '✅ Confirm & Record Time-Out';
    }

    document.getElementById('webcamModalOverlay').classList.add('active');
    resetWebcamToCapture();
    startWebcamCamera();
    startLiveLocation();
}

function closeWebcam() {
    captureRevision++;
    cameraRevision++;
    stopLiveLocation();
    capturedLocation = null;
    stopWebcamCamera();
    document.getElementById('webcamModalOverlay').classList.remove('active');
    activeCapturedDataUri = null;
}

function waitForCameraFrame(video, track) {
    return new Promise((resolve, reject) => {
        let playing = false;
        const readinessEvents = ['loadeddata', 'canplay', 'playing'];
        const timer = setTimeout(() => finish(new Error('Camera preview timed out')), 10000);
        function finish(error) {
            clearTimeout(timer);
            readinessEvents.forEach(event => video.removeEventListener(event, checkFrame));
            track.removeEventListener('unmute', checkFrame);
            if (error) reject(error);
            else resolve();
        }
        function checkFrame() {
            if (playing && track.readyState === 'live' && !track.muted &&
                video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA && video.videoWidth > 0) finish();
        }
        readinessEvents.forEach(event => video.addEventListener(event, checkFrame));
        track.addEventListener('unmute', checkFrame);
        video.play().then(() => {
            playing = true;
            checkFrame();
        }, finish);
    });
}

function requestCamera(profile) {
    return new Promise((resolve, reject) => {
        let timedOut = false;
        const timer = setTimeout(() => {
            timedOut = true;
            reject(new DOMException('Camera access timed out', 'TimeoutError'));
        }, 20000);
        navigator.mediaDevices.getUserMedia({ video: profile, audio: false }).then(stream => {
            clearTimeout(timer);
            if (timedOut) stream.getTracks().forEach(track => track.stop());
            else resolve(stream);
        }, error => {
            clearTimeout(timer);
            reject(error);
        });
    });
}

async function startWebcamCamera() {
    const revision = ++cameraRevision;
    const video = document.getElementById('cameraVideo');
    const status = document.getElementById('cameraStatus');
    const capture = document.getElementById('captureBtn');
    const retry = document.getElementById('retryCameraBtn');

    stopWebcamCamera();
    retry.hidden = true;
    capture.disabled = true;
    status.className = 'camera-status';
    status.textContent = 'Starting camera preview...';

    if (!navigator.mediaDevices?.getUserMedia) {
        status.className = 'camera-status error';
        status.textContent = 'Camera requires HTTPS or localhost and a supported browser.';
        return;
    }

    const profiles = [
        { facingMode: { ideal: 'user' }, width: { ideal: 640 }, height: { ideal: 480 } },
        true
    ];
    let cameraError;
    for (const profile of profiles) {
        try {
            const stream = await requestCamera(profile);
            if (revision !== cameraRevision) {
                stream.getTracks().forEach(track => track.stop());
                return;
            }
            activeWebcamStream = stream;
            const [track] = stream.getVideoTracks();
            if (!track) throw new DOMException('No video track', 'NotFoundError');
            video.muted = true;
            video.srcObject = stream;
            await waitForCameraFrame(video, track);
            if (revision !== cameraRevision) return;
            track.addEventListener('ended', () => {
                if (revision !== cameraRevision || activeWebcamStream !== stream) return;
                stopWebcamCamera();
                if (capture.disabled) return;
                capture.disabled = true;
                status.className = 'camera-status error';
                status.textContent = 'The camera disconnected. Reconnect it and retry.';
                retry.hidden = false;
            }, { once: true });
            status.className = 'camera-status success';
            status.textContent = 'Camera ready. Align your face and tap Capture.';
            capture.disabled = false;
            return;
        } catch (error) {
            if (revision !== cameraRevision) return;
            stopWebcamCamera();
            cameraError = error.name;
            if (['NotAllowedError', 'SecurityError', 'TimeoutError'].includes(cameraError)) break;
        }
    }

    const messages = {
        NotAllowedError: 'Camera access was blocked. Allow Camera in this site’s browser settings and in Windows privacy settings, then retry.',
        SecurityError: 'Camera access is disabled by the browser or device. Enable access and retry.',
        NotFoundError: 'No camera was found. Connect or enable your webcam, then retry.',
        NotReadableError: 'The camera could not start. Close other apps or tabs using it and check the webcam privacy switch, then retry.',
        TimeoutError: 'Camera access timed out. Check for a permission prompt near the address bar, then retry.'
    };
    status.className = 'camera-status error';
    status.textContent = messages[cameraError] || 'The camera did not send a preview. Check the webcam privacy switch and close other apps using it, then retry.';
    retry.hidden = false;
}

function stopWebcamCamera() {
    if (activeWebcamStream) {
        activeWebcamStream.getTracks().forEach(t => t.stop());
        activeWebcamStream = null;
    }
    const video = document.getElementById('cameraVideo');
    if (video) video.srcObject = null;
}

async function capturePhoto() {
    const video = document.getElementById('cameraVideo');
    const canvas = document.getElementById('cameraCanvas');

    const captureBtn = document.getElementById('captureBtn');
    if (!video?.videoWidth || !activeWebcamStream || captureBtn.disabled) return;

    captureBtn.disabled = true;
    const revision = ++captureRevision;
    const capturedAt = new Date();
    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status';
    statusEl.textContent = 'Photo taken. Getting current GPS location...';
    const scale = Math.min(1, 640 / Math.max(video.videoWidth, video.videoHeight));
    const w = Math.round(video.videoWidth * scale);
    const h = Math.round(video.videoHeight * scale);

    canvas.width = w;
    canvas.height = h;

    const ctx = canvas.getContext('2d');

    // Mirror image so preview matches user's selfie view
    ctx.save();
    ctx.scale(-1, 1);
    ctx.drawImage(video, -w, 0, w, h);
    ctx.restore();

    const location = await readCaptureLocation(capturedAt);
    if (revision !== captureRevision) return;
    capturedLocation = location;
    drawTaascorWatermark(ctx, w, h, capturedAt, capturedLocation);

    activeCapturedDataUri = canvas.toDataURL('image/jpeg', 0.85);

    document.getElementById('capturedPhotoPreview').src = activeCapturedDataUri;
    document.getElementById('capturedPhotoWrap').style.display = 'block';
    document.getElementById('cameraPreviewWrap').style.display = 'none';

    document.getElementById('captureStepWrap').style.display = 'none';
    document.getElementById('confirmRow').style.display = 'flex';

    statusEl.className = location ? 'camera-status success' : 'camera-status';
    statusEl.textContent = location
        ? 'Photo and GPS captured. Confirm below to record your punch.'
        : 'GPS unavailable. Allow location and retake, or confirm with the photo only.';
}

function retakePhoto() {
    captureRevision++;
    capturedLocation = null;
    activeCapturedDataUri = null;
    resetWebcamToCapture();
    if (!activeWebcamStream) {
        startWebcamCamera();
    } else {
        const statusEl = document.getElementById('cameraStatus');
        statusEl.className = 'camera-status success';
        statusEl.innerHTML = '<span>🎥</span><span>Live Camera Active — Align face within guide and tap Capture</span>';
    }
}

function resetWebcamToCapture() {
    document.getElementById('capturedPhotoWrap').style.display = 'none';
    document.getElementById('cameraPreviewWrap').style.display = 'block';
    document.getElementById('captureStepWrap').style.display = 'block';
    document.getElementById('captureRow').style.display = 'flex';
    document.getElementById('confirmRow').style.display = 'none';
    const captureBtn = document.getElementById('captureBtn');
    captureBtn.disabled = !activeWebcamStream;
}

function submitPunch() {
    if (!activeCapturedDataUri) {
        alert('Please capture a photo first.');
        return;
    }

    const btn = document.getElementById('submitPunchBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Recording…';

    stopLiveLocation();
    stopWebcamCamera();

    const latVal = capturedLocation?.lat ?? '';
    const lngVal = capturedLocation?.lng ?? '';
    const accVal = capturedLocation?.accuracy ?? '';
    const locVal = capturedLocation ? `${latVal}, ${lngVal} (±${accVal} m)` : '';

    if (currentWebcamMode === 'time-in') {
        document.getElementById('timeInPhotoHidden').value = activeCapturedDataUri;
        document.getElementById('timeInReturnTo').value = currentReturnUrl;
        document.getElementById('timeInLat').value = latVal;
        document.getElementById('timeInLng').value = lngVal;
        document.getElementById('timeInAccuracy').value = accVal;
        document.getElementById('timeInLocation').value = locVal;
        document.getElementById('sharedTimeInForm').submit();
    } else {
        document.getElementById('timeOutPhotoHidden').value = activeCapturedDataUri;
        document.getElementById('timeOutReturnTo').value = currentReturnUrl;
        document.getElementById('timeOutLat').value = latVal;
        document.getElementById('timeOutLng').value = lngVal;
        document.getElementById('timeOutAccuracy').value = accVal;
        document.getElementById('timeOutLocation').value = locVal;
        document.getElementById('sharedTimeOutForm').submit();
    }
}

// Lightbox
function openLightbox(src) {
    if (!src) return;
    document.getElementById('lightboxImg').src = src;
    document.getElementById('photoLightbox').classList.add('active');
}
function closeLightbox() {
    document.getElementById('photoLightbox').classList.remove('active');
    document.getElementById('lightboxImg').src = '';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeLightbox();
        closeWebcam();
    }
});
</script>
