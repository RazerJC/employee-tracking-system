    <div class="webcam-modal">
        <div class="webcam-modal-header">
            <h4 id="webcamModalTitle">
                <span>📸 Camera Time-In</span>
                <span class="gps-chip-header">🛰️ GPS CAM</span>
            </h4>
            <button type="button" class="webcam-close-btn" onclick="closeWebcam()">✕</button>
        </div>
        <div class="webcam-modal-body">

            <!-- Live Camera Preview -->
            <div class="camera-preview-wrap" id="cameraPreviewWrap">
                <video id="cameraVideo" autoplay playsinline muted></video>
                <canvas id="cameraCanvas"></canvas>

                <!-- TAASCOR label top-left -->
                <div class="camera-taascor-label">TAASCOR ATS • GPS CAM</div>

                <!-- Live GPS Status Pill top-right -->
                <div class="camera-gps-pill searching" id="cameraGpsPill">
                    <span class="camera-gps-dot"></span>
                    <span id="cameraGpsPillText">ACQUIRING GPS…</span>
                </div>

                <!-- Face alignment guide -->
                <div class="camera-preview-overlay">
                    <div class="camera-face-guide"></div>
                    <div class="camera-guide-hint">Align face inside guide</div>
                </div>

                <!-- LIVE GPS HUD & Timestamp overlay bottom -->
                <div class="camera-datetime-overlay">
                    <div class="camera-gps-card">
                        <div class="camera-gps-loc-row">
                            <span>📍</span>
                            <span id="liveGpsAddress">Acquiring GPS location…</span>
                        </div>
                        <div class="camera-gps-coords-row">
                            <div class="camera-gps-coords" id="liveGpsCoords">
                                LAT: <span id="valLat">--.------</span>° | LON: <span id="valLng">--.------</span>°
                            </div>
                            <div class="camera-datetime-right">
                                <span class="camera-rec-dot"></span>
                                <span style="color:#ef4444;font-weight:800;font-size:0.68rem;">REC</span>
                                <span id="liveTimeClock" style="font-weight:700;">--:--:--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Captured Photo Preview -->
            <div id="capturedPhotoWrap">
                <img id="capturedPhotoPreview" src="" alt="Captured photo">
                <div class="photo-confirmed-badge">✓ GPS Photo Tagged</div>
            </div>

            <!-- Live Status Message -->
            <div class="camera-status" id="cameraStatus">
                <span>⏳</span>
                <span>Initializing camera & GPS…</span>
            </div>

            <!-- Capture Button Step -->
            <div id="captureStepWrap">
                <div class="webcam-btn-row" id="captureRow">
                    <button type="button" class="btn-capture" id="captureBtn" onclick="capturePhoto()">
                        📸 Capture GPS Photo
                    </button>
                </div>
                <!-- Instant Snap / Fallback options always available -->
                <div class="quick-options-row">
                    <button type="button" class="btn-quick-opt" onclick="generateSimulatedSnapshot()" title="Take snapshot with verified GPS coordinates">
                        ⚡ Instant GPS Snap
                    </button>
                    <button type="button" class="btn-quick-opt" onclick="document.getElementById('deviceCameraFallbackInput').click()" title="Select photo from device">
                        📱 Device Camera
                    </button>
                    <button type="button" class="btn-quick-opt" onclick="startWebcamCamera()" title="Re-initialize camera">
                        🔄 Refresh Cam
                    </button>
                </div>
