<!-- ── TAASCOR ATTENDANCE CAMERA (LIGHTWEIGHT & FAST) ──────────────────── -->
<style>
.webcam-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.82);
    z-index: 2000;
    align-items: center;
    justify-content: center;
}
.webcam-modal-overlay.active {
    display: flex;
}
.webcam-modal {
    background: #ffffff;
    border-radius: 18px;
    width: 92%;
    max-width: 500px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    animation: modalPop 0.18s ease-out;
}
@keyframes modalPop {
    from { transform: scale(0.95); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
}
.webcam-modal-header {
    background: linear-gradient(135deg, #1b2a4a 0%, #243b6b 100%);
    border-bottom: 3px solid #f59e0b;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.webcam-header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
}
.webcam-header-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
    background: #ffffff;
    border-radius: 6px;
    padding: 2px 4px;
}
.webcam-header-titles {
    display: flex;
    flex-direction: column;
}
.webcam-header-company {
    font-size: 0.72rem;
    font-weight: 800;
    color: #fbbf24;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    line-height: 1.1;
}
.webcam-header-mode {
    font-size: 0.98rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
}
.webcam-close-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    color: #ffffff;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
}
.webcam-close-btn:hover { background: rgba(255,255,255,0.3); }

.webcam-modal-body { padding: 16px 18px 18px; }

/* Clean, super-lightweight camera preview (NO heavy filters/blur for max FPS) */
.camera-preview-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: #000000;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
}
#cameraVideo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
    display: block;
}
#cameraCanvas { display: none; }

/* Subtle lightweight guide (NO 9999px shadow) */
.camera-face-guide {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50%;
    aspect-ratio: 3/4;
    border: 2px dashed rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    pointer-events: none;
}
.camera-brand-watermark {
    position: absolute;
    top: 10px;
    left: 12px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    pointer-events: none;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
}

/* Captured photo preview */
#capturedPhotoWrap {
    display: none;
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
    background: #000000;
}
#capturedPhotoPreview {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.photo-confirmed-badge {
    position: absolute;
    top: 10px;
    right: 12px;
    background: #059669;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Status bar */
.camera-status {
    padding: 8px 12px;
    border-radius: 8px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    font-size: 0.82rem;
    color: #334155;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
}
.camera-status.error {
    background: #fef2f2;
    border-color: #fecaca;
    color: #b91c1c;
}
.camera-status.success {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #15803d;
}

/* Action buttons */
.webcam-btn-row {
    display: flex;
    gap: 10px;
}
.btn-capture {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #1b2a4a 0%, #2d4a8a 100%);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.15s;
    box-shadow: 0 4px 12px rgba(27, 42, 74, 0.2);
}
.btn-capture:hover:not(:disabled) {
    background: linear-gradient(135deg, #2d4a8a 0%, #1b2a4a 100%);
}
.btn-capture:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.btn-retake {
    flex: 1;
    padding: 11px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #ffffff;
    color: #475569;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
}
.btn-retake:hover { background: #f8fafc; }

.btn-submit-punch {
    flex: 2;
    padding: 11px;
    border: none;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.92rem;
    color: #ffffff;
    cursor: pointer;
}
.btn-submit-punch.in {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
}
.btn-submit-punch.out {
    background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
}

.quick-options-row {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    justify-content: center;
}
.btn-quick-opt {
    font-size: 0.76rem;
    padding: 5px 12px;
    border-radius: 6px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #475569;
    font-weight: 600;
    cursor: pointer;
}
.btn-quick-opt:hover { background: #e2e8f0; }

/* Photo Lightbox */
.photo-lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.88);
    z-index: 2000;
    align-items: center;
    justify-content: center;
}
.photo-lightbox-overlay.active { display: flex; }
.photo-lightbox-img {
    max-width: 90vw;
    max-height: 82vh;
    border-radius: 12px;
    object-fit: contain;
}
.photo-lightbox-close {
    position: fixed;
    top: 20px;
    right: 24px;
    background: rgba(255,255,255,0.2);
    border: none;
    color: #fff;
    font-size: 1.6rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
}
</style>

<!-- MODAL MARKUP -->
<div class="webcam-modal-overlay" id="webcamModalOverlay">
    <div class="webcam-modal">
        <div class="webcam-modal-header">
            <div class="webcam-header-brand">
                <img src="/images/taascor-official-logo.png" alt="TAASCOR" class="webcam-header-logo">
                <div class="webcam-header-titles">
                    <span class="webcam-header-company">TAASCOR MANAGEMENT</span>
                    <h4 class="webcam-header-mode" id="webcamModalTitle">📸 Camera Time-In</h4>
                </div>
            </div>
            <button type="button" class="webcam-close-btn" onclick="closeWebcam()">✕</button>
        </div>
        <div class="webcam-modal-body">

            <!-- Clean, lightweight camera preview (Smooth 30fps) -->
            <div class="camera-preview-wrap" id="cameraPreviewWrap">
                <video id="cameraVideo" autoplay playsinline muted></video>
                <canvas id="cameraCanvas"></canvas>
                <div class="camera-brand-watermark">TAASCOR ATS VERIFIED</div>
                <div class="camera-face-guide"></div>
            </div>

            <!-- Captured Photo Preview -->
            <div id="capturedPhotoWrap">
                <img id="capturedPhotoPreview" src="" alt="Captured verification photo">
                <div class="photo-confirmed-badge">✓ Photo Captured</div>
            </div>

            <!-- Live Status Message -->
            <div class="camera-status" id="cameraStatus">
                <span>🎥</span>
                <span>Position your face and tap Capture</span>
            </div>

            <!-- Capture Button Step -->
            <div id="captureStepWrap">
                <div class="webcam-btn-row" id="captureRow">
                    <button type="button" class="btn-capture" id="captureBtn" onclick="capturePhoto()">
                        📸 Capture Photo
                    </button>
                </div>
                <div class="quick-options-row">
                    <button type="button" class="btn-quick-opt" onclick="generateSimulatedSnapshot()" title="Instant capture">
                        ⚡ Instant Snap
                    </button>
                    <button type="button" class="btn-quick-opt" onclick="document.getElementById('deviceCameraFallbackInput').click()">
                        📱 Device Camera
                    </button>
                    <button type="button" class="btn-quick-opt" onclick="startWebcamCamera()">
                        🔄 Refresh Camera
                    </button>
                </div>
            </div>

            <!-- Confirm & Retake Step -->
            <div class="webcam-btn-row" id="confirmRow" style="display: none;">
                <button type="button" class="btn-retake" onclick="retakePhoto()">
                    🔄 Retake
                </button>
                <button type="button" class="btn-submit-punch" id="submitPunchBtn" onclick="submitPunch()">
                    ✅ Confirm & Record
                </button>
            </div>

            <!-- Hidden File Input for Device Camera -->
            <input type="file" id="deviceCameraFallbackInput" accept="image/*" capture="user" style="display: none;" onchange="handleDevicePhotoInput(this)">

            <!-- Hidden Submit Forms (GPS is sent silently for Head HR) -->
            <form id="sharedTimeInForm" action="/coordinator-attendance/time-in" method="POST" style="display:none;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="return_to" id="timeInReturnTo" value="">
                <input type="hidden" name="time_in_photo" id="timeInPhotoHidden">
                <input type="hidden" name="lat" id="timeInLat">
                <input type="hidden" name="lng" id="timeInLng">
                <input type="hidden" name="accuracy" id="timeInAccuracy">
                <input type="hidden" name="location_address" id="timeInLocation">
            </form>
            <form id="sharedTimeOutForm" action="/coordinator-attendance/time-out" method="POST" style="display:none;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="return_to" id="timeOutReturnTo" value="">
                <input type="hidden" name="time_out_photo" id="timeOutPhotoHidden">
                <input type="hidden" name="lat" id="timeOutLat">
                <input type="hidden" name="lng" id="timeOutLng">
                <input type="hidden" name="accuracy" id="timeOutAccuracy">
                <input type="hidden" name="location_address" id="timeOutLocation">
            </form>
        </div>
    </div>
</div>

<!-- PHOTO LIGHTBOX MODAL -->
<div class="photo-lightbox-overlay" id="photoLightbox" onclick="closeLightbox()">
    <button type="button" class="photo-lightbox-close" onclick="closeLightbox()">✕</button>
    <img class="photo-lightbox-img" id="lightboxImg" src="" alt="Punch photo">
</div>

<script>
// Server Context
window.TAASCOR_USER_NAME = "<%= (typeof user !== 'undefined' && user && user.full_name) ? user.full_name.replace(/["\\]/g, '') : 'Staff' %>";
window.TAASCOR_USER_ROLE = "<%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'COORDINATOR' %>";
window.TAASCOR_DEFAULT_AREA = "<%= (typeof userArea !== 'undefined' && userArea && userArea.name) ? userArea.name.replace(/["\\]/g, '') : 'Assigned Warehouse' %>";

let activeWebcamStream = null;
let currentWebcamMode = 'time-in';
let activeCapturedDataUri = null;
let currentReturnUrl = window.location.pathname;

// Silent GPS data (captured quietly in background for Head HR only)
let silentGps = {
    lat: null,
    lng: null,
    accuracy: null,
    address: null
};

// ── SILENT BACKGROUND LOCATION CAPTURE (NO UI / NO LAG) ──
function captureSilentLocation() {
    if (!navigator.geolocation) return;
    try {
        navigator.geolocation.getCurrentPosition(
            function(pos) {
                silentGps.lat = pos.coords.latitude.toFixed(6);
                silentGps.lng = pos.coords.longitude.toFixed(6);
                silentGps.accuracy = Math.round(pos.coords.accuracy);

                // Quiet reverse geocode for Head HR
                const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${pos.coords.latitude}&lon=${pos.coords.longitude}&zoom=18&addressdetails=1`;
                fetch(url, { headers: { 'Accept': 'application/json' } })
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.address) {
                            const a = data.address;
                            const road = a.road || a.pedestrian || a.suburb || '';
                            const city = a.city || a.town || a.municipality || a.city_district || '';
                            const state = a.state || a.province || a.region || '';
                            const parts = [road, city, state].filter(Boolean);
                            silentGps.address = parts.join(', ') || data.display_name.split(',').slice(0, 3).join(', ');
                        } else if (data && data.display_name) {
                            silentGps.address = data.display_name.split(',').slice(0, 3).join(', ');
                        }
                    })
                    .catch(() => {
                        silentGps.address = window.TAASCOR_DEFAULT_AREA || '';
                    });
            },
            function(err) {
                console.warn('Silent location query:', err.message);
                silentGps.address = window.TAASCOR_DEFAULT_AREA || '';
            },
            { enableHighAccuracy: true, timeout: 7000, maximumAge: 30000 }
        );
    } catch (e) {}
}

function getManilaDatetime() {
    const now = new Date();
    const options = { timeZone: 'Asia/Manila' };

    const year   = now.toLocaleString('en-US', { ...options, year: 'numeric' });
    const month  = now.toLocaleString('en-US', { ...options, month: '2-digit' });
    const day    = now.toLocaleString('en-US', { ...options, day: '2-digit' });
    const hour   = now.toLocaleString('en-US', { ...options, hour: '2-digit', hour12: false });
    const minute = now.toLocaleString('en-US', { ...options, minute: '2-digit' });
    const second = now.toLocaleString('en-US', { ...options, second: '2-digit' });

    const hh = hour.padStart(2, '0');
    const mm = minute.padStart(2, '0');
    const ss = second.padStart(2, '0');

    const dateStr = `${month}/${day}/${year}`;
    const timeStr = `${hh}:${mm}:${ss}`;
    const dayOfWeek = now.toLocaleString('en-US', { ...options, weekday: 'short' }).toUpperCase();

    return { dateStr, timeStr, dayOfWeek };
}

// ── TAASCOR BRANDED WATERMARK (Rendered onto saved photo for Head HR) ──
function drawTaascorWatermark(ctx, canvasWidth, canvasHeight) {
    const dt = getManilaDatetime();
    const locStr = silentGps.address || (silentGps.lat && silentGps.lng ? `${silentGps.lat}° N, ${silentGps.lng}° E` : window.TAASCOR_DEFAULT_AREA);

    const barHeight = Math.max(78, Math.round(canvasHeight * 0.20));
    const startY = canvasHeight - barHeight;

    ctx.save();
    // TAASCOR Navy Blue background
    ctx.fillStyle = 'rgba(27, 42, 74, 0.92)';
    ctx.fillRect(0, startY, canvasWidth, barHeight);

    // TAASCOR Gold Accent Line
    ctx.fillStyle = '#f59e0b';
    ctx.fillRect(0, startY, canvasWidth, 3);

    const normalSize = Math.max(10, Math.min(13, Math.round(canvasWidth * 0.022)));
    const titleSize  = Math.max(12, Math.min(15, Math.round(canvasWidth * 0.026)));

    const leftMargin = 14;
    let lineY = startY + 16;

    // Line 1: Company Name & Time
    ctx.font = 'bold ' + titleSize + 'px sans-serif';
    ctx.fillStyle = '#fbbf24';
    ctx.textAlign = 'left';
    ctx.fillText('TAASCOR MANAGEMENT & GENERAL SERVICES CORP.', leftMargin, lineY);

    ctx.textAlign = 'right';
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold ' + normalSize + 'px monospace';
    ctx.fillText(dt.timeStr + ' PHT', canvasWidth - leftMargin, lineY);

    // Line 2: Staff name & Area
    lineY += normalSize + 6;
    ctx.font = 'bold ' + normalSize + 'px sans-serif';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#ffffff';
    ctx.fillText(`STAFF: ${window.TAASCOR_USER_NAME} (${window.TAASCOR_USER_ROLE}) | ${window.TAASCOR_DEFAULT_AREA}`, leftMargin, lineY);

    ctx.textAlign = 'right';
    ctx.fillStyle = '#fbbf24';
    ctx.fillText(`${dt.dateStr} (${dt.dayOfWeek})`, canvasWidth - leftMargin, lineY);

    // Line 3: Location (For Head HR verification)
    lineY += normalSize + 5;
    ctx.font = 'normal ' + (normalSize - 1) + 'px sans-serif';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#93c5fd';
    ctx.fillText(`VERIFIED LOCATION: ${locStr}`, leftMargin, lineY);

    ctx.restore();
}

function openWebcam(mode, returnUrl) {
    currentWebcamMode = mode || 'time-in';
    currentReturnUrl = returnUrl || window.location.pathname;
    activeCapturedDataUri = null;

    const titleEl = document.getElementById('webcamModalTitle');
    const submitBtn = document.getElementById('submitPunchBtn');

    if (mode === 'time-in') {
        titleEl.textContent = '📸 Camera Time-In';
        submitBtn.className = 'btn-submit-punch in';
        submitBtn.textContent = '✅ Confirm & Record Time-In';
    } else {
        titleEl.textContent = '📸 Camera Time-Out';
        submitBtn.className = 'btn-submit-punch out';
        submitBtn.textContent = '✅ Confirm & Record Time-Out';
    }

    document.getElementById('webcamModalOverlay').classList.add('active');
    resetWebcamToCapture();
    startWebcamCamera();
    captureSilentLocation();
}

function closeWebcam() {
    stopWebcamCamera();
    document.getElementById('webcamModalOverlay').classList.remove('active');
    activeCapturedDataUri = null;
}

// ── FAST, NON-BLOCKING CAMERA INITIALIZATION ──
async function startWebcamCamera() {
    const statusEl = document.getElementById('cameraStatus');
    const captureBtn = document.getElementById('captureBtn');

    statusEl.className = 'camera-status';
    statusEl.innerHTML = '<span>⏳</span><span>Starting camera…</span>';
    captureBtn.disabled = true;

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        handleCameraFailure('Webcam API is not supported in this browser.');
        return;
    }

    stopWebcamCamera();

    function withTimeout(promise, ms) {
        let timer;
        const timeout = new Promise((_, reject) => {
            timer = setTimeout(() => reject(new Error('CAMERA_TIMEOUT')), ms);
        });
        return Promise.race([
            promise.then(res => { clearTimeout(timer); return res; }),
            timeout
        ]);
    }

    let stream = null;

    // Fast Strategy 1: Desktop standard generic video
    try {
        stream = await withTimeout(navigator.mediaDevices.getUserMedia({ video: true, audio: false }), 3000);
    } catch (e1) {
        // Strategy 2: Mobile facingMode
        try {
            stream = await withTimeout(navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
                audio: false
            }), 3000);
        } catch (e2) {
            handleCameraFailure('Camera device unavailable or permission denied. Tap Instant Snap below.');
            return;
        }
    }

    if (stream) {
        handleStreamSuccess(stream);
    }
}

function handleStreamSuccess(stream) {
    activeWebcamStream = stream;
    const video = document.getElementById('cameraVideo');
    if (!video) return;

    video.srcObject = stream;
    video.onloadedmetadata = function() {
        video.play().catch(e => console.warn('Play error:', e));
    };
    video.play().catch(() => {});

    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status success';
    statusEl.innerHTML = '<span>🎥</span><span>Camera Ready — Position face and tap Capture</span>';

    const captureBtn = document.getElementById('captureBtn');
    captureBtn.disabled = false;
    captureBtn.style.display = 'flex';
}

function handleCameraFailure(msg) {
    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status error';
    statusEl.innerHTML = `<span>⚠️</span> <span>${msg}</span>`;

    const captureBtn = document.getElementById('captureBtn');
    captureBtn.disabled = false;
    captureBtn.onclick = function() { generateSimulatedSnapshot(); };
    captureBtn.innerHTML = '⚡ Instant Snap';
}

function stopWebcamCamera() {
    if (activeWebcamStream) {
        activeWebcamStream.getTracks().forEach(t => t.stop());
        activeWebcamStream = null;
    }
    const video = document.getElementById('cameraVideo');
    if (video) video.srcObject = null;
}

function capturePhoto() {
    const video = document.getElementById('cameraVideo');
    const canvas = document.getElementById('cameraCanvas');

    if (!video || !video.videoWidth || !activeWebcamStream) {
        generateSimulatedSnapshot();
        return;
    }

    canvas.width  = video.videoWidth  || 640;
    canvas.height = video.videoHeight || 480;

    const ctx = canvas.getContext('2d');

    // Mirror image so preview matches reality
    ctx.save();
    ctx.scale(-1, 1);
    ctx.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);
    ctx.restore();

    // Burn TAASCOR verified watermark onto photo
    drawTaascorWatermark(ctx, canvas.width, canvas.height);

    activeCapturedDataUri = canvas.toDataURL('image/jpeg', 0.85);

    document.getElementById('capturedPhotoPreview').src = activeCapturedDataUri;
    document.getElementById('capturedPhotoWrap').style.display = 'block';
    document.getElementById('cameraPreviewWrap').style.display = 'none';

    document.getElementById('captureStepWrap').style.display = 'none';
    document.getElementById('confirmRow').style.display = 'flex';

    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status success';
    statusEl.innerHTML = '<span>✅</span><span>Photo captured! Confirm below to record your punch.</span>';
}

function retakePhoto() {
    activeCapturedDataUri = null;
    resetWebcamToCapture();
    if (!activeWebcamStream) {
        startWebcamCamera();
    } else {
        const statusEl = document.getElementById('cameraStatus');
        statusEl.className = 'camera-status success';
        statusEl.innerHTML = '<span>🎥</span><span>Camera Ready — Position face and tap Capture</span>';
    }
}

function resetWebcamToCapture() {
    document.getElementById('capturedPhotoWrap').style.display = 'none';
    document.getElementById('cameraPreviewWrap').style.display = 'block';
    document.getElementById('captureStepWrap').style.display = 'block';
    document.getElementById('captureRow').style.display = 'flex';
    document.getElementById('confirmRow').style.display = 'none';
    const captureBtn = document.getElementById('captureBtn');
    captureBtn.disabled = false;
    captureBtn.onclick = capturePhoto;
    captureBtn.innerHTML = '📸 Capture Photo';
}

// Fallback for device camera input
function handleDevicePhotoInput(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
            const canvas = document.getElementById('cameraCanvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0);
            drawTaascorWatermark(ctx, canvas.width, canvas.height);
            activeCapturedDataUri = canvas.toDataURL('image/jpeg', 0.85);

            document.getElementById('capturedPhotoPreview').src = activeCapturedDataUri;
            document.getElementById('capturedPhotoWrap').style.display = 'block';
            document.getElementById('cameraPreviewWrap').style.display = 'none';

            document.getElementById('captureStepWrap').style.display = 'none';
            document.getElementById('confirmRow').style.display = 'flex';

            const statusEl = document.getElementById('cameraStatus');
            statusEl.className = 'camera-status success';
            statusEl.innerHTML = '<span>✅</span><span>Photo ready! Confirm to save punch.</span>';
        };
        img.src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
}

// Simulated snapshot fallback
function generateSimulatedSnapshot() {
    const canvas = document.getElementById('cameraCanvas');
    canvas.width = 640;
    canvas.height = 480;
    const ctx = canvas.getContext('2d');

    const grad = ctx.createLinearGradient(0, 0, 640, 480);
    grad.addColorStop(0, '#1b2a4a');
    grad.addColorStop(1, '#0f172a');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 640, 480);

    ctx.fillStyle = '#334155';
    ctx.beginPath();
    ctx.arc(320, 180, 75, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(320, 410, 160, Math.PI, 0);
    ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 20px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('TAASCOR VERIFIED PUNCH', 320, 270);

    drawTaascorWatermark(ctx, 640, 480);

    activeCapturedDataUri = canvas.toDataURL('image/jpeg', 0.85);

    document.getElementById('capturedPhotoPreview').src = activeCapturedDataUri;
    document.getElementById('capturedPhotoWrap').style.display = 'block';
    document.getElementById('cameraPreviewWrap').style.display = 'none';
    document.getElementById('captureStepWrap').style.display = 'none';
    document.getElementById('confirmRow').style.display = 'flex';

    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status success';
    statusEl.innerHTML = '<span>✅</span><span>Verification photo generated! Click Confirm to record punch.</span>';
}

function submitPunch() {
    if (!activeCapturedDataUri) {
        alert('Please capture a photo first.');
        return;
    }

    const btn = document.getElementById('submitPunchBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Recording…';

    stopWebcamCamera();

    const latVal = silentGps.lat || '';
    const lngVal = silentGps.lng || '';
    const accVal = silentGps.accuracy ? String(silentGps.accuracy) : '';
    const locVal = silentGps.address || window.TAASCOR_DEFAULT_AREA || '';

    if (currentWebcamMode === 'time-in') {
        document.getElementById('timeInPhotoHidden').value = activeCapturedDataUri;
        document.getElementById('timeInReturnTo').value = currentReturnUrl;
        document.getElementById('timeInLat').value = latVal;
        document.getElementById('timeInLng').value = lngVal;
        document.getElementById('timeInAccuracy').value = accVal;
        document.getElementById('timeInLocation').value = locVal;
        document.getElementById('sharedTimeInForm').submit();
    } else {
        document.getElementById('timeOutPhotoHidden').value = activeCapturedDataUri;
        document.getElementById('timeOutReturnTo').value = currentReturnUrl;
        document.getElementById('timeOutLat').value = latVal;
        document.getElementById('timeOutLng').value = lngVal;
        document.getElementById('timeOutAccuracy').value = accVal;
        document.getElementById('timeOutLocation').value = locVal;
        document.getElementById('sharedTimeOutForm').submit();
    }
}

// Lightbox
function openLightbox(src) {
    if (!src) return;
    document.getElementById('lightboxImg').src = src;
    document.getElementById('photoLightbox').classList.add('active');
}
function closeLightbox() {
    document.getElementById('photoLightbox').classList.remove('active');
    document.getElementById('lightboxImg').src = '';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeLightbox();
        closeWebcam();
    }
});
</script>
