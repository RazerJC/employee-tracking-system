            <!-- Confirm & Retake Step -->
            <div class="webcam-btn-row" id="confirmRow" style="display: none;">
                <button type="button" class="btn-retake" onclick="retakePhoto()">
                    🔄 Retake
                </button>
                <button type="button" class="btn-submit-punch" id="submitPunchBtn" onclick="submitPunch()">
                    ✅ Confirm & Record
