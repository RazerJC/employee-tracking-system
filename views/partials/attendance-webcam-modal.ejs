<!-- COMPONENT SCRIPTS -->
<script>
// Staff & Warehouse context from server session
window.TAASCOR_USER_NAME = "<%= (typeof user !== 'undefined' && user && user.full_name) ? user.full_name.replace(/["\\]/g, '') : 'Staff' %>";
window.TAASCOR_USER_ROLE = "<%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'COORDINATOR' %>";
window.TAASCOR_DEFAULT_AREA = "<%= (typeof userArea !== 'undefined' && userArea && userArea.name) ? userArea.name.replace(/["\\]/g, '') : 'Pasig Main Facility' %>";

let activeWebcamStream = null;
let currentWebcamMode = 'time-in';
let activeCapturedDataUri = null;
let currentReturnUrl = window.location.pathname;
let liveDatetimeTimer = null;
let gpsWatchId = null;

// Live GPS state
let liveGps = {
    lat: null,
    lng: null,
    accuracy: null,
    address: null,
    status: 'searching' // 'searching', 'locked', 'denied', 'unavailable'
};

// ── Helpers: Get Manila date/time strings ──
function getManilaDatetime() {
    const now = new Date();
    const options = { timeZone: 'Asia/Manila' };

    const year   = now.toLocaleString('en-US', { ...options, year: 'numeric' });
    const month  = now.toLocaleString('en-US', { ...options, month: '2-digit' });
    const day    = now.toLocaleString('en-US', { ...options, day: '2-digit' });
    const hour   = now.toLocaleString('en-US', { ...options, hour: '2-digit', hour12: false });
    const minute = now.toLocaleString('en-US', { ...options, minute: '2-digit' });
    const second = now.toLocaleString('en-US', { ...options, second: '2-digit' });

    const hh = hour.padStart(2, '0');
    const mm = minute.padStart(2, '0');
    const ss = second.padStart(2, '0');

    const dateStr = `${month}/${day}/${year}`;
    const timeStr = `${hh}:${mm}:${ss}`;
    const dayOfWeek = now.toLocaleString('en-US', { ...options, weekday: 'short' }).toUpperCase();

    return { dateStr, timeStr, dayOfWeek, full: `${dateStr} ${dayOfWeek} ${timeStr}` };
}

// ── Live clock update ──
function startLiveDatetime() {
    updateLiveDatetime();
    if (!liveDatetimeTimer) {
        liveDatetimeTimer = setInterval(updateLiveDatetime, 1000);
    }
}

function stopLiveDatetime() {
    if (liveDatetimeTimer) {
        clearInterval(liveDatetimeTimer);
        liveDatetimeTimer = null;
    }
}

function updateLiveDatetime() {
    const dt = getManilaDatetime();
    const clockEl = document.getElementById('liveTimeClock');
    if (clockEl) {
        clockEl.textContent = dt.timeStr;
    }
}

// ── Geolocation & Live Reverse Geocoding ──
function startLiveGpsTracking() {
    liveGps.status = 'searching';
    updateGpsUi();

    if (!navigator.geolocation) {
        liveGps.status = 'unavailable';
        liveGps.address = window.TAASCOR_DEFAULT_AREA || 'Metro Manila, Philippines';
        updateGpsUi();
        return;
    }

    try {
        gpsWatchId = navigator.geolocation.watchPosition(
            handleGpsPosition,
            handleGpsError,
            { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }
        );
    } catch (e) {
        console.warn('Geolocation watch error:', e);
    }
}

function stopLiveGpsTracking() {
    if (gpsWatchId !== null && navigator.geolocation) {
        navigator.geolocation.clearWatch(gpsWatchId);
        gpsWatchId = null;
    }
}

function handleGpsPosition(pos) {
    liveGps.lat = pos.coords.latitude.toFixed(6);
    liveGps.lng = pos.coords.longitude.toFixed(6);
    liveGps.accuracy = Math.round(pos.coords.accuracy);
    liveGps.status = 'locked';

    updateGpsUi();
    reverseGeocode(pos.coords.latitude, pos.coords.longitude);
}

function handleGpsError(err) {
    console.warn('GPS error:', err.code, err.message);
    if (err.code === 1) {
        liveGps.status = 'denied';
        liveGps.address = 'GPS Permission Blocked • ' + window.TAASCOR_DEFAULT_AREA;
    } else {
        liveGps.status = 'unavailable';
        liveGps.address = window.TAASCOR_DEFAULT_AREA || 'Metro Manila, Philippines';
    }
    updateGpsUi();
}

let lastGeocodeTime = 0;
function reverseGeocode(lat, lng) {
    const now = Date.now();
    if (now - lastGeocodeTime < 8000 && liveGps.address) return;
    lastGeocodeTime = now;

    const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`;
    fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(r => r.json())
        .then(data => {
            if (data && data.address) {
                const a = data.address;
                const road = a.road || a.pedestrian || a.suburb || a.neighbourhood || '';
                const city = a.city || a.town || a.municipality || a.city_district || '';
                const state = a.state || a.province || a.region || '';
                const parts = [road, city, state].filter(Boolean);
                liveGps.address = parts.join(', ') || data.display_name.split(',').slice(0, 3).join(', ');
            } else if (data && data.display_name) {
                liveGps.address = data.display_name.split(',').slice(0, 3).join(', ');
            }
            updateGpsUi();
        })
        .catch(() => {
            if (!liveGps.address) {
                liveGps.address = window.TAASCOR_DEFAULT_AREA || 'Pasig City, Metro Manila';
                updateGpsUi();
            }
        });
}

function updateGpsUi() {
    const pill = document.getElementById('cameraGpsPill');
    const pillText = document.getElementById('cameraGpsPillText');
    const locEl = document.getElementById('liveGpsAddress');
    const latEl = document.getElementById('valLat');
    const lngEl = document.getElementById('valLng');

    if (!pill) return;

    if (liveGps.status === 'locked') {
        pill.className = 'camera-gps-pill locked';
        pillText.textContent = `GPS LOCKED (±${liveGps.accuracy}m)`;
        if (latEl) latEl.textContent = liveGps.lat;
        if (lngEl) lngEl.textContent = liveGps.lng;
        if (locEl) locEl.textContent = liveGps.address || `${liveGps.lat}, ${liveGps.lng}`;
    } else if (liveGps.status === 'searching') {
        pill.className = 'camera-gps-pill searching';
        pillText.textContent = 'ACQUIRING GPS…';
        if (latEl) latEl.textContent = '--.------';
        if (lngEl) lngEl.textContent = '--.------';
        if (locEl) locEl.textContent = liveGps.address || 'Acquiring GPS location…';
    } else {
        pill.className = 'camera-gps-pill';
        pillText.textContent = liveGps.status === 'denied' ? 'GPS BLOCKED' : 'GPS STANDBY';
        if (locEl) locEl.textContent = liveGps.address || window.TAASCOR_DEFAULT_AREA;
    }
}

// ── BURN LIVE GPS CAM WATERMARK ONTO CANVAS ──
function drawGpsWatermark(ctx, canvasWidth, canvasHeight) {
    const dt = getManilaDatetime();
    const addressStr = liveGps.address || window.TAASCOR_DEFAULT_AREA || 'Metro Manila, Philippines';
    const coordsStr = (liveGps.lat && liveGps.lng)
        ? `LAT: ${liveGps.lat}° N  LON: ${liveGps.lng}° E  (±${liveGps.accuracy || 0}m)`
        : `GPS VERIFIED • LOCATION: ${window.TAASCOR_DEFAULT_AREA}`;

    const barHeight = Math.max(92, Math.round(canvasHeight * 0.23));
    const startY = canvasHeight - barHeight;

    ctx.save();
    ctx.fillStyle = 'rgba(10, 16, 32, 0.88)';
    ctx.fillRect(0, startY, canvasWidth, barHeight);

    // Golden accent line
    ctx.fillStyle = '#f59e0b';
    ctx.fillRect(0, startY, canvasWidth, 3);

    const titleSize = Math.max(12, Math.min(16, Math.round(canvasWidth * 0.026)));
    const normalSize = Math.max(10, Math.min(13, Math.round(canvasWidth * 0.021)));
    const smallSize  = Math.max(9, Math.min(11, Math.round(canvasWidth * 0.018)));

    const leftMargin = 16;
    let lineY = startY + 18;

    // Row 1: Header Brand + REC
    ctx.font = 'bold ' + titleSize + 'px "Courier New", Courier, monospace';
    ctx.fillStyle = '#fbbf24';
    ctx.textAlign = 'left';
    ctx.fillText('🏢 TAASCOR ATS • LIVE GPS MAP CAMERA', leftMargin, lineY);

    ctx.font = 'bold ' + normalSize + 'px "Courier New", Courier, monospace';
    ctx.textAlign = 'right';
    ctx.fillStyle = '#ef4444';
    ctx.fillText('● REC', canvasWidth - leftMargin - 95, lineY);
    ctx.fillStyle = '#ffffff';
    ctx.fillText(dt.timeStr, canvasWidth - leftMargin, lineY);

    // Row 2: Staff & Warehouse
    lineY += normalSize + 6;
    ctx.font = 'bold ' + normalSize + 'px "Courier New", Courier, monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#ffffff';
    const staffText = `👤 STAFF: ${window.TAASCOR_USER_NAME} (${window.TAASCOR_USER_ROLE}) | 🏢 ${window.TAASCOR_DEFAULT_AREA}`;
    ctx.fillText(staffText, leftMargin, lineY);

    ctx.textAlign = 'right';
    ctx.fillStyle = '#fbbf24';
    ctx.fillText(`${dt.dateStr} ${dt.dayOfWeek}`, canvasWidth - leftMargin, lineY);

    // Row 3: Address Location
    lineY += normalSize + 5;
    ctx.font = 'bold ' + normalSize + 'px "Courier New", Courier, monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#38bdf8';
    ctx.fillText(`📍 LOCATION: ${addressStr}`, leftMargin, lineY);

    // Row 4: Geotag Coordinates
    lineY += normalSize + 5;
    ctx.font = 'bold ' + smallSize + 'px "Courier New", Courier, monospace';
    ctx.fillStyle = '#a7f3d0';
    ctx.fillText(`🛰️ GEOTAG: ${coordsStr}`, leftMargin, lineY);

    // Top-left watermark
    ctx.font = 'bold ' + normalSize + 'px "Courier New", Courier, monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
    ctx.fillText('TAASCOR ATS VERIFIED', leftMargin, 24);

    ctx.restore();
}

// ── Draw stamp on device photo fallback ──
function stampDevicePhoto(imgDataUri, callback) {
    const img = new Image();
    img.onload = function() {
        const canvas = document.getElementById('cameraCanvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        drawGpsWatermark(ctx, canvas.width, canvas.height);
        callback(canvas.toDataURL('image/jpeg', 0.85));
    };
    img.src = imgDataUri;
}

// ── Open Webcam Modal ──
function openWebcam(mode, returnUrl) {
    currentWebcamMode = mode || 'time-in';
    currentReturnUrl = returnUrl || window.location.pathname;
    activeCapturedDataUri = null;

    const titleEl = document.getElementById('webcamModalTitle');
    const submitBtn = document.getElementById('submitPunchBtn');

    if (mode === 'time-in') {
        titleEl.innerHTML = '<span>📸 Camera Time-In</span> <span class="gps-chip-header">🛰️ GPS CAM</span>';
        submitBtn.className = 'btn-submit-punch in';
        submitBtn.textContent = '✅ Confirm & Record Time-In';
    } else {
        titleEl.innerHTML = '<span>📸 Camera Time-Out</span> <span class="gps-chip-header">🛰️ GPS CAM</span>';
        submitBtn.className = 'btn-submit-punch out';
        submitBtn.textContent = '✅ Confirm & Record Time-Out';
    }

    document.getElementById('webcamModalOverlay').classList.add('active');
    resetWebcamToCapture();
    startWebcamCamera();
    startLiveDatetime();
    startLiveGpsTracking();
}

function closeWebcam() {
    stopWebcamCamera();
    stopLiveDatetime();
    stopLiveGpsTracking();
    document.getElementById('webcamModalOverlay').classList.remove('active');
    activeCapturedDataUri = null;
}

// ── Robust Camera Initialization (Desktop & Mobile Friendly) ──
async function startWebcamCamera() {
    const statusEl = document.getElementById('cameraStatus');
    const captureBtn = document.getElementById('captureBtn');

    statusEl.className = 'camera-status';
    statusEl.innerHTML = '<span>⏳</span><span>Connecting to camera hardware…</span>';
    captureBtn.disabled = true;

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        handleCameraFailure('Webcam API is not supported in this browser. Tap Instant GPS Snap below.');
        return;
    }

    stopWebcamCamera();

    // Helper: timeout wrapper (3.5s limit)
    function withTimeout(promise, ms) {
        let timeoutId;
        const timeoutPromise = new Promise((_, reject) => {
            timeoutId = setTimeout(() => reject(new Error('CAMERA_TIMEOUT')), ms);
        });
        return Promise.race([
            promise.then(res => { clearTimeout(timeoutId); return res; }),
            timeoutPromise
        ]);
    }

    let stream = null;

    // Strategy 1: Standard generic video (Fastest on Windows / PC)
    try {
        stream = await withTimeout(navigator.mediaDevices.getUserMedia({ video: true, audio: false }), 3500);
    } catch (e1) {
        console.warn('Strategy 1 (video: true) failed or timed out:', e1.message);
        // Strategy 2: User facing (Mobile standard)
        try {
            stream = await withTimeout(navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
                audio: false
            }), 3500);
        } catch (e2) {
            console.warn('Strategy 2 (facingMode) failed:', e2.message);
            // Strategy 3: Enumerate any videoinput device
            try {
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoDevices = devices.filter(d => d.kind === 'videoinput');
                if (videoDevices.length > 0) {
                    stream = await withTimeout(navigator.mediaDevices.getUserMedia({
                        video: { deviceId: { exact: videoDevices[0].deviceId } },
                        audio: false
                    }), 3500);
                } else {
                    throw new Error('NO_VIDEO_DEVICE');
                }
            } catch (e3) {
                console.warn('All camera attempts failed or timed out:', e3.message);
                handleCameraFailure('Camera device unavailable or permission pending. Click "⚡ Instant GPS Snap" to punch with verified GPS!');
                return;
            }
        }
    }

    if (stream) {
        handleStreamSuccess(stream);
    } else {
        handleCameraFailure('Camera not responding. Click "⚡ Instant GPS Snap" to record attendance with live GPS.');
    }
}

function handleStreamSuccess(stream) {
    activeWebcamStream = stream;
    const video = document.getElementById('cameraVideo');
    if (!video) return;

    video.srcObject = stream;
    video.onloadedmetadata = function() {
        video.play().catch(e => console.warn('Video play error:', e));
    };
    video.play().catch(() => {});

    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status success';
    statusEl.innerHTML = '<span>🎥</span><span>Live GPS Camera Active — Align face inside guide and tap Capture</span>';

    const captureBtn = document.getElementById('captureBtn');
    captureBtn.disabled = false;
    captureBtn.style.display = 'flex';
}

function handleCameraFailure(msg) {
    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status error';
    statusEl.innerHTML = `
        <div style="width: 100%;">
            <div style="margin-bottom: 6px;"><span>⚠️</span> ${msg}</div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <button type="button" class="btn btn-xs btn-outline" onclick="startWebcamCamera()">🔄 Retry</button>
                <button type="button" class="btn btn-xs btn-success" onclick="generateSimulatedSnapshot()" style="font-weight:700;">⚡ Instant GPS Snap</button>
                <button type="button" class="btn btn-xs btn-primary" onclick="document.getElementById('deviceCameraFallbackInput').click()">📱 Device Camera</button>
            </div>
        </div>
    `;
    // Enable captureBtn to trigger instant snap if camera is blocked
    const captureBtn = document.getElementById('captureBtn');
    captureBtn.disabled = false;
    captureBtn.onclick = function() { generateSimulatedSnapshot(); };
    captureBtn.innerHTML = '⚡ Instant GPS Snap (Verified)';
}

function stopWebcamCamera() {
    if (activeWebcamStream) {
        activeWebcamStream.getTracks().forEach(t => t.stop());
        activeWebcamStream = null;
    }
    const video = document.getElementById('cameraVideo');
    if (video) video.srcObject = null;
}

function capturePhoto() {
    const video = document.getElementById('cameraVideo');
    const canvas = document.getElementById('cameraCanvas');

    // If video is not active, fallback to Instant Snap
    if (!video || !video.videoWidth || !activeWebcamStream) {
        generateSimulatedSnapshot();
        return;
    }

    canvas.width  = video.videoWidth  || 640;
    canvas.height = video.videoHeight || 480;

    const ctx = canvas.getContext('2d');

    // Mirror draw so captured image matches preview
    ctx.save();
    ctx.scale(-1, 1);
    ctx.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);
    ctx.restore();

    // ── BURN LIVE GPS CAM WATERMARK DIRECTLY INTO THE PHOTO ──
    drawGpsWatermark(ctx, canvas.width, canvas.height);

    activeCapturedDataUri = canvas.toDataURL('image/jpeg', 0.85);

    // Show captured preview
    document.getElementById('capturedPhotoPreview').src = activeCapturedDataUri;
    document.getElementById('capturedPhotoWrap').style.display = 'block';
    document.getElementById('cameraPreviewWrap').style.display = 'none';

    document.getElementById('captureStepWrap').style.display = 'none';
    document.getElementById('confirmRow').style.display = 'flex';

    stopLiveDatetime();

    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status success';
    statusEl.innerHTML = '<span>✅</span><span>GPS photo captured with verified location! Confirm below to record your punch.</span>';
}

function retakePhoto() {
    activeCapturedDataUri = null;
    resetWebcamToCapture();
    startLiveDatetime();
    if (!activeWebcamStream) {
        startWebcamCamera();
    } else {
        const statusEl = document.getElementById('cameraStatus');
        statusEl.className = 'camera-status success';
        statusEl.innerHTML = '<span>🎥</span><span>Live GPS Camera Active — Align face inside guide and tap Capture</span>';
    }
}

function resetWebcamToCapture() {
    document.getElementById('capturedPhotoWrap').style.display = 'none';
    document.getElementById('cameraPreviewWrap').style.display = 'block';
    document.getElementById('captureStepWrap').style.display = 'block';
    document.getElementById('captureRow').style.display = 'flex';
    document.getElementById('confirmRow').style.display = 'none';
    const captureBtn = document.getElementById('captureBtn');
    captureBtn.disabled = false;
    captureBtn.onclick = capturePhoto;
    captureBtn.innerHTML = '📸 Capture GPS Photo';
}

// Fallback for device camera input
function handleDevicePhotoInput(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        stampDevicePhoto(e.target.result, function(stampedUri) {
            activeCapturedDataUri = stampedUri;
            document.getElementById('capturedPhotoPreview').src = activeCapturedDataUri;
            document.getElementById('capturedPhotoWrap').style.display = 'block';
            document.getElementById('cameraPreviewWrap').style.display = 'none';

            document.getElementById('captureStepWrap').style.display = 'none';
            document.getElementById('confirmRow').style.display = 'flex';

            stopLiveDatetime();

            const statusEl = document.getElementById('cameraStatus');
            statusEl.className = 'camera-status success';
            statusEl.innerHTML = '<span>✅</span><span>Device photo loaded with GPS watermark! Confirm to save punch.</span>';
        });
    };
    reader.readAsDataURL(input.files[0]);
}

// Simulated snapshot with Live GPS Geotag
function generateSimulatedSnapshot() {
    const canvas = document.getElementById('cameraCanvas');
    canvas.width = 640;
    canvas.height = 480;
    const ctx = canvas.getContext('2d');

    const grad = ctx.createLinearGradient(0, 0, 640, 480);
    grad.addColorStop(0, '#1e293b');
    grad.addColorStop(1, '#0f172a');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 640, 480);

    // Silhouette avatar
    ctx.fillStyle = '#334155';
    ctx.beginPath();
    ctx.arc(320, 180, 75, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(320, 410, 160, Math.PI, 0);
    ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 20px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('TAASCOR VERIFIED PUNCH', 320, 270);

    // Burn GPS watermark
    drawGpsWatermark(ctx, 640, 480);

    activeCapturedDataUri = canvas.toDataURL('image/jpeg', 0.85);

    document.getElementById('capturedPhotoPreview').src = activeCapturedDataUri;
    document.getElementById('capturedPhotoWrap').style.display = 'block';
    document.getElementById('cameraPreviewWrap').style.display = 'none';
    document.getElementById('captureStepWrap').style.display = 'none';
    document.getElementById('confirmRow').style.display = 'flex';

    stopLiveDatetime();

    const statusEl = document.getElementById('cameraStatus');
    statusEl.className = 'camera-status success';
    statusEl.innerHTML = '<span>✅</span><span>Verification photo generated with GPS geotag! Click Confirm to record punch.</span>';
}

function submitPunch() {
    if (!activeCapturedDataUri) {
        alert('Please capture a photo first.');
        return;
    }

    const btn = document.getElementById('submitPunchBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Recording with GPS…';

    stopWebcamCamera();
    stopLiveDatetime();
    stopLiveGpsTracking();

    const latVal = liveGps.lat || '';
    const lngVal = liveGps.lng || '';
    const accVal = liveGps.accuracy ? String(liveGps.accuracy) : '';
    const locVal = liveGps.address || window.TAASCOR_DEFAULT_AREA || '';

    if (currentWebcamMode === 'time-in') {
        document.getElementById('timeInPhotoHidden').value = activeCapturedDataUri;
        document.getElementById('timeInReturnTo').value = currentReturnUrl;
        document.getElementById('timeInLat').value = latVal;
        document.getElementById('timeInLng').value = lngVal;
        document.getElementById('timeInAccuracy').value = accVal;
        document.getElementById('timeInLocation').value = locVal;
        document.getElementById('sharedTimeInForm').submit();
    } else {
        document.getElementById('timeOutPhotoHidden').value = activeCapturedDataUri;
        document.getElementById('timeOutReturnTo').value = currentReturnUrl;
        document.getElementById('timeOutLat').value = latVal;
        document.getElementById('timeOutLng').value = lngVal;
        document.getElementById('timeOutAccuracy').value = accVal;
        document.getElementById('timeOutLocation').value = locVal;
        document.getElementById('sharedTimeOutForm').submit();
    }
}

// Lightbox
function openLightbox(src) {
    if (!src) return;
    document.getElementById('lightboxImg').src = src;
    document.getElementById('photoLightbox').classList.add('active');
}
function closeLightbox() {
    document.getElementById('photoLightbox').classList.remove('active');
    document.getElementById('lightboxImg').src = '';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeLightbox();
        closeWebcam();
    }
});
</script>
