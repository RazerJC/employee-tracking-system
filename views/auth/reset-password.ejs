<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TAASCOR</title>
    <link rel="icon" href="/images/taascor-official-logo.png" type="image/png">
    <link rel="stylesheet" href="/css/login.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        .reset-card {
            width: 460px;
            max-width: 90%;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 0 35px rgba(0, 0, 0, 0.18);
            padding: 40px 35px;
            text-align: center;
            margin: auto;
        }
        .reset-card img {
            width: 280px;
            max-width: 90%;
            margin-bottom: 14px;
        }
        .reset-card h1 {
            font-size: 26px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 8px;
        }
        .reset-card p {
            font-size: 14px;
            color: #64748b;
            margin-bottom: 20px;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="reset-card">
        <img src="/images/taascor-logo.svg" alt="TAASCOR MANAGEMENT & GENERAL SERVICES CORP.">
        <h1>Set New Password</h1>
        <p>Please enter your new password below (at least 8 characters).</p>

        <% if (typeof flash !== 'undefined' && flash.error) { %>
            <div class="auth-alert auth-alert-error"><%= flash.error %></div>
        <% } %>
        <% if (typeof flash !== 'undefined' && flash.success) { %>
            <div class="auth-alert auth-alert-success"><%= flash.success %></div>
        <% } %>

        <form action="/reset-password" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="token" value="<%= token %>">

            <div class="input-box">
                <input type="password" id="password" name="password" placeholder="New Password (min 8 chars)" minlength="8" required autofocus>
                <i class='bx bx-lock-alt'></i>
            </div>

            <div class="input-box">
                <input type="password" id="confirm_password" name="confirm_password" placeholder="Confirm New Password" minlength="8" required>
                <i class='bx bx-lock'></i>
            </div>

            <button type="submit" class="btn" style="margin-top: 14px;">Update Password</button>

            <div class="forgot-link" style="margin-top: 18px;">
                <a href="/login">Return to Sign In</a>
            </div>
        </form>
    </div>
</body>
</html>
