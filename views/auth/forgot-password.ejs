<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TAASCOR</title>
    <link rel="icon" href="/images/taascor-official-logo.png" type="image/png">
    <link rel="stylesheet" href="/css/login.css">
    <style>
        .forgot-card {
            width: 460px;
            max-width: 100%;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 0 35px rgba(0, 0, 0, 0.18);
            padding: 40px 35px;
            text-align: center;
            margin: auto;
        }
        .forgot-card img {
            width: 280px;
            max-width: 90%;
            margin-bottom: 14px;
        }
        .forgot-card h1 {
            font-size: 26px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 8px;
        }
        .forgot-card p {
            font-size: 14px;
            color: #64748b;
            margin-bottom: 20px;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="forgot-card">
        <img src="/images/taascor-logo.svg" alt="TAASCOR MANAGEMENT & GENERAL SERVICES CORP.">
        <h1>Reset Password</h1>
        <p>Enter your company email address and we will send password reset instructions.</p>

        <% if (typeof flash !== 'undefined' && flash.error) { %>
            <div class="auth-alert auth-alert-error"><%= flash.error %></div>
        <% } %>
        <% if (typeof flash !== 'undefined' && flash.success) { %>
            <div class="auth-alert auth-alert-success"><%= flash.success %></div>
        <% } %>

        <form action="/forgot-password" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="input-box">
                <input type="text" name="email" placeholder="Username or Company Email" required autofocus>
                <i class='bx bx-envelope'></i>
            </div>

            <button type="submit" class="btn" style="margin-top: 14px;">Send Reset Link</button>

            <div class="forgot-link" style="margin-top: 18px;">
                <a href="/login">Return to Sign In</a>
            </div>
        </form>
    </div>
</body>
</html>
