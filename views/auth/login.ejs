<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Login - TAASCOR' %></title>
    <link rel="icon" href="/images/taascor-official-logo.png" type="image/png">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

    <div class="container <%= (typeof isRegister !== 'undefined' && isRegister) ? 'active' : '' %>" id="container">
        <!-- Sign Up Form (Coordinator Registration) -->
        <div class="form-container sign-up">
            <form action="/register" method="POST" id="registerForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <img src="/images/taascor-logo.svg" alt="TAASCOR MANAGEMENT & GENERAL SERVICES CORP." class="brand-logo">
                <h1>Sign Up</h1>

                <% if (typeof flash !== 'undefined' && flash.error && (typeof isRegister !== 'undefined' && isRegister)) { %>
                    <div class="auth-alert auth-alert-error"><%= flash.error %></div>
                <% } %>

                <div class="input-box">
                    <input type="text" name="full_name" placeholder="Full Name" required>
                    <i class='bx bx-user'></i>
                </div>
                <div class="input-box">
                    <input type="text" name="email" placeholder="Username or Company Email" required>
                    <i class='bx bx-envelope'></i>
                </div>
                <div class="input-box">
                    <select name="role" id="registerRole" required onchange="handleRegisterRoleChange(this.value)" style="width: 100%; height: 100%; background: transparent; border: none; outline: none; font-size: 14px; color: #333; padding-left: 5px; -webkit-appearance: none;">
                        <option value="COORDINATOR" selected>Coordinator (Approved by HR)</option>
                        <option value="HR">HR Staff (Approved by Head HR)</option>
                        <option value="HEAD_HR">Head HR (Approved by Admin)</option>
                    </select>
                    <i class='bx bx-id-card'></i>
                </div>
                <div class="input-box" id="registerAreaBox">
                    <select name="area_id" id="registerAreaSelect" required style="width: 100%; height: 100%; background: transparent; border: none; outline: none; font-size: 14px; color: #333; padding-left: 5px; -webkit-appearance: none;">
                        <option value="" disabled selected>Select Assigned Warehouse / Area *</option>
                        <% if (typeof areas !== 'undefined' && areas.length) { %>
                            <% areas.forEach(a => { %>
                                <option value="<%= a.id %>"><%= a.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <i class='bx bx-building'></i>
                </div>

                <div class="input-box">
                    <input type="password" id="registerPassword" name="password" placeholder="Password (min 6 chars)" minlength="6" required>
                    <i class='bx bx-lock-alt'></i>
                </div>
                <div class="input-box">
                    <input type="password" id="registerConfirmPassword" name="confirm_password" placeholder="Confirm Password" minlength="6" required>
                    <i class='bx bx-check-shield'></i>
                </div>

                <div class="options-row">
                    <input type="checkbox" id="showRegisterPassword">
                    <label for="showRegisterPassword">Show password</label>
                </div>

                <button type="submit" class="btn">Sign Up</button>

                <div class="mobile-toggle">
                    Already have an account? <a id="mobileLogin">Sign In</a>
                </div>
            </form>
        </div>

        <!-- Sign In Form (Login) -->
        <div class="form-container sign-in">
            <form action="/login" method="POST" id="loginForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <img src="/images/taascor-logo.svg" alt="TAASCOR MANAGEMENT & GENERAL SERVICES CORP." class="brand-logo">
                <h1>Login</h1>

                <!-- Flash Alerts -->
                <% if (typeof flash !== 'undefined') { %>
                    <% if (flash.success) { %>
                        <div class="auth-alert auth-alert-success"><%= flash.success %></div>
                    <% } %>
                    <% if (flash.error && (!locals.isRegister)) { %>
                        <div class="auth-alert auth-alert-error"><%= flash.error %></div>
                    <% } %>
                    <% if (flash.warning) { %>
                        <div class="auth-alert auth-alert-warning"><%= flash.warning %></div>
                    <% } %>
                <% } %>

                <% if (typeof suspended !== 'undefined' && suspended) { %>
                    <div class="auth-alert auth-alert-error">Your session ended because this account has been suspended or deactivated.</div>
                <% } %>

                <div class="input-box">
                    <input type="text" name="email" placeholder="Email or Username" required autofocus>
                    <i class='bx bx-user'></i>
                </div>
                <div class="input-box">
                    <input type="password" id="loginPassword" name="password" placeholder="Password" autocomplete="current-password" required>
                    <i class='bx bx-lock-alt'></i>
                </div>

                <div class="options-row">
                    <input type="checkbox" id="showLoginPassword">
                    <label for="showLoginPassword">Show password</label>
                </div>

                <button type="submit" class="btn">Login</button>

                <div class="forgot-link">
                    <a href="/forgot-password">Forgot Password?</a>
                </div>

                <div class="mobile-toggle">
                    Need an account? <a id="mobileRegister">Sign Up</a>
                </div>
            </form>
        </div>

        <!-- Sliding Overlay Toggle Container -->
        <div class="toggle-container">
            <div class="toggle">
                <div class="toggle-panel toggle-left">
                    <h1 class="greet">Welcome Back!</h1>
                    <p>Already have an account? Sign in with your approved company credentials.</p>
                    <button type="button" class="btn-toggle" id="login">Sign In</button>
                </div>
                <div class="toggle-panel toggle-right">
                    <h1 class="greet">Hello, Welcome!</h1>
                    <p>Need an account?</p>
                    <p>Contact IT Administrator or register as Coordinator.</p>
                    <button type="button" class="btn-toggle" id="register">Sign Up</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toggle & Password Visibility Script -->
    <script>
        const container = document.getElementById('container');
        const registerBtn = document.getElementById('register');
        const loginBtn = document.getElementById('login');
        const mobileRegister = document.getElementById('mobileRegister');
        const mobileLogin = document.getElementById('mobileLogin');

        function showSignUp() {
            container.classList.add("active");
            if (window.location.pathname !== '/register') {
                window.history.pushState({ tab: 'register' }, '', '/register');
            }
        }

        function showSignIn() {
            container.classList.remove("active");
            if (window.location.pathname !== '/login') {
                window.history.pushState({ tab: 'login' }, '', '/login');
            }
        }

        registerBtn?.addEventListener('click', showSignUp);
        loginBtn?.addEventListener('click', showSignIn);
        mobileRegister?.addEventListener('click', showSignUp);
        mobileLogin?.addEventListener('click', showSignIn);

        window.addEventListener('popstate', () => {
            if (window.location.pathname === '/register') {
                container.classList.add("active");
            } else {
                container.classList.remove("active");
            }
        });

        // Show/Hide Password for Login
        document.getElementById('showLoginPassword')?.addEventListener('change', function () {
            const password = document.getElementById('loginPassword');
            if (password) password.type = this.checked ? 'text' : 'password';
        });

        // Show/Hide Password for Register
        document.getElementById('showRegisterPassword')?.addEventListener('change', function () {
            const pass = document.getElementById('registerPassword');
            const confirmPass = document.getElementById('registerConfirmPassword');
            const type = this.checked ? 'text' : 'password';
            if (pass) pass.type = type;
            if (confirmPass) confirmPass.type = type;
        });

        function handleRegisterRoleChange(role) {
            const box = document.getElementById('registerAreaBox');
            const select = document.getElementById('registerAreaSelect');
            if (box && select) {
                if (role === 'COORDINATOR') {
                    box.style.display = 'block';
                    select.setAttribute('required', 'required');
                } else {
                    box.style.display = 'none';
                    select.removeAttribute('required');
                }
            }
        }
    </script>
</body>
</html>
