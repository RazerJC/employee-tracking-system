<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2><%= title %></h2>
        <p>Changes here are saved to the masterlist.</p>
    </div>
    <a href="/masterlist" class="btn btn-outline">Back to Masterlist</a>
</div>

<% if (error) { %>
    <p class="alert alert-error" role="alert"><%= error %></p>
<% } %>

<form method="POST" action="/masterlist/<%= record.id %>/edit" class="card">
    <div class="card-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="masterlist-fields">
            <% for (const [label, key, type = 'text'] of columns) { %>
                <div class="form-group">
                    <label for="masterlist-<%= key %>"><%= label %></label>
                    <input class="form-control" id="masterlist-<%= key %>" name="<%= key %>"
                        type="<%= type %>" value="<%= record[key] ?? '' %>"
                        <% if (key === 'department' && assignedDepartment) { %> readonly<% } %>
                        <% if (type === 'number') { %> min="0" step="any"<% } else { %> maxlength="500"<% } %>>
                    <% if (key === 'department' && assignedDepartment) { %>
                        <a class="form-help" href="/employees/<%= record.id %>/edit">Change department in Employee Details</a>
                    <% } %>
                </div>
            <% } %>
        </div>
        <button type="submit" class="btn btn-primary">Save Details</button>
    </div>
</form>

<%- include('../partials/layout-bottom') %>
