<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Manpower Request #<%= request.id %></h2>
        <div class="breadcrumb">
            <a href="/manpower">Manpower Requests</a>
            <span>/</span>
            <span><%= request.area_name %></span>
            <span>•</span>
            <span>Term Deployment: <%= formatDate(request.deployment_date) %></span>
        </div>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
        <%- include('../partials/status-badge', { status: request.status }) %>
        <% if (!['filled'].includes(request.status) && (user.role === 'HR' || user.role === 'ADMIN' || user.role === 'HEAD_HR' || (user.role === 'COORDINATOR' && request.requested_by === user.id))) { %>
        <form method="POST" action="/manpower/<%= request.id %>/delete" onsubmit="return confirm('Delete this manpower request? This cannot be undone.')" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm" style="background: var(--color-danger); color: #fff; border: none;">🗑 Delete Request</button>
        </form>
        <% } %>
    </div>
</div>

<div class="card mb-3"><div class="card-body"><strong>Assigned HR:</strong> <%= request.handler_name || 'Awaiting HR acceptance' %>
<% if (user.role === 'HR' && !request.handler_name && !['filled','declined','cancelled'].includes(request.status)) { %>
<form method="POST" action="/manpower/<%= request.id %>/claim"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit">Accept & handle request</button></form>
<% } %></div></div>
<!-- Request Metrics Cards (Prompt Requirement: Separate display of requested, allocated, confirmed, remaining) -->
<div class="summary-cards" style="margin-bottom: 20px;">
    <div class="summary-card" style="padding: 14px 18px;">
        <div class="card-data">
            <h4><%= summary.totalRequested %></h4>
            <p>Total Requested</p>
        </div>
    </div>
    <div class="summary-card" style="padding: 14px 18px;">
        <div class="card-data">
            <h4 style="color: var(--color-warning);"><%= summary.proposed %></h4>
            <p>Proposed by HR</p>
        </div>
    </div>
    <div class="summary-card" style="padding: 14px 18px;">
        <div class="card-data">
            <h4 style="color: var(--color-success);"><%= summary.confirmed %></h4>
            <p>Confirmed on Duty</p>
        </div>
    </div>
    <div class="summary-card" style="padding: 14px 18px;">
        <div class="card-data">
            <h4 style="color: var(--color-accent);"><%= summary.remaining %></h4>
            <p>Remaining Vacancies</p>
        </div>
    </div>
</div>

<!-- Request Information Grid -->
<div class="detail-grid card mb-3" style="padding: 20px;">
    <div class="detail-item">
        <div class="detail-label">Warehouse / Area</div>
        <div class="detail-value"><%= request.area_name %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Submitted By</div>
        <div class="detail-value"><%= request.requester_name || 'Coordinator' %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Required Term Deployment Date</div>
        <div class="detail-value"><strong><%= formatDate(request.deployment_date) %></strong></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Shift Details</div>
        <div class="detail-value"><%= request.shift_details || 'Regular Shift' %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Priority Level</div>
        <div class="detail-value"><span class="badge badge-warning"><%= request.priority.toUpperCase() %></span></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Operational Reason</div>
        <div class="detail-value"><%= request.reason %></div>
    </div>
</div>

<!-- Requested Position Breakdown -->
<div class="card mb-3">
    <div class="card-header">
        <h3>📋 Requested Position Breakdown</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Workers Needed</th>
                </tr>
            </thead>
            <tbody>
                <% requestedPositions.forEach(p => { %>
                    <tr>
                        <td><strong><%= p.position_title %></strong></td>
                        <td><span class="badge badge-primary"><%= p.quantity_requested %> Worker(s)</span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Worker Allocations & Arrival Confirmations -->
<div class="card mb-3">
    <div class="card-header">
        <h3>👥 Worker Allocations & Deployments (<%= allocations.length %>)</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Worker Candidate</th>
                        <th>Requested Position</th>
                        <th>Actual Position</th>
                        <th>Status</th>
                        <th>Allocated By</th>
                        <th class="text-right">Coordinator Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (allocations.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center" style="padding: 24px;">
                                No workers allocated by HR yet.
                            </td>
                        </tr>
                    <% } else { %>
                        <% allocations.forEach(a => { %>
                            <tr>
                                <td>
                                    <strong><%= a.worker_name || a.existing_emp_name %></strong>
                                    <% if (a.emp_code) { %>
                                        <br><span class="text-muted text-xs"><%= a.emp_code %></span>
                                    <% } %>
                                </td>
                                <td><%= a.requested_position_title || 'General' %></td>
                                <td>
                                    <%= a.actual_position_title || a.requested_position_title || '—' %>
                                    <% if (a.position_change_reason) { %>
                                        <div class="text-xs" style="color: var(--color-accent); font-weight: 500;">
                                            Note: <%= a.position_change_reason %>
                                        </div>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (a.status === 'confirmed') { %>
                                        <span class="badge badge-success">✓ Confirmed On Duty</span>
                                    <% } else if (a.status === 'did_not_report') { %>
                                        <span class="badge badge-danger">✕ Did Not Report</span>
                                    <% } else { %>
                                        <span class="badge badge-warning">⏳ Awaiting Arrival</span>
                                    <% } %>
                                </td>
                                <td><%= a.allocated_by_name %></td>
                                <td class="text-right">
                                    <% if (a.status === 'proposed') { %>
                                        <div class="btn-group" style="justify-content: flex-end;">
                                            <button type="button" class="btn btn-sm btn-success" 
                                                    onclick="openArrivalModal('<%= a.id %>', '<%= a.worker_name || a.existing_emp_name %>', '<%= a.request_position_id %>')">
                                                Confirm Arrival
                                            </button>
                                            <form action="/manpower/<%= request.id %>/confirm-arrival" method="POST" style="display: inline;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="allocation_id" value="<%= a.id %>">
                                                <input type="hidden" name="status_decision" value="did_not_report">
                                                <button type="submit" class="btn btn-sm btn-outline" style="color: var(--color-danger);" 
                                                        onclick="return confirm('Mark this worker as Did Not Report?')">
                                                    No Show
                                                </button>
                                            </form>
                                        </div>
                                    <% } else { %>
                                        <span class="text-muted text-xs">Processed</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Confirm Worker Arrival (Coordinator assigns actual position & schedule) -->
<div id="arrivalModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; align-items: center; justify-content: center;">
    <div class="card" style="max-width: 550px; width: 90%; margin: auto; background: white;">
        <div class="card-header">
            <h3>Confirm Worker Arrival & Deployment</h3>
            <button type="button" class="alert-close" onclick="document.getElementById('arrivalModal').style.display='none'">×</button>
        </div>
        <div class="card-body">
            <form action="/manpower/<%= request.id %>/confirm-arrival" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="allocation_id" id="modalAllocId">
                <input type="hidden" name="status_decision" value="confirmed">

                <p style="font-size: 0.88rem; color: var(--color-gray-600); margin-bottom: 16px;">
                    Confirming arrival for: <strong id="modalWorkerName"></strong><br>
                    This will activate the worker in your warehouse's <strong>Active Masterfile</strong> and update manpower fulfillment counts.
                </p>

                <div class="form-group">
                    <label for="actual_position_id">Actual Assigned Position <span class="required">*</span></label>
                    <select id="actual_position_id" name="actual_position_id" class="form-control" required onchange="checkPositionChange(this)">
                        <% positionsList.forEach(p => { %>
                            <option value="<%= p.id %>"><%= p.title %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" id="posReasonGroup" style="display: none;">
                    <label for="position_change_reason">Reason for Position Change</label>
                    <input type="text" id="position_change_reason" name="position_change_reason" class="form-control" placeholder="Explain why actual position differs from requested">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="shift_start">Deployment Shift Start</label>
                        <input type="time" id="shift_start" name="shift_start" class="form-control" value="08:00">
                    </div>
                    <div class="form-group">
                        <label for="shift_end">Deployment Shift End</label>
                        <input type="time" id="shift_end" name="shift_end" class="form-control" value="17:00">
                    </div>
                </div>

                <div class="btn-group" style="margin-top: 20px;">
                    <button type="submit" class="btn btn-success btn-lg">Confirm Arrival & Deploy</button>
                    <button type="button" class="btn btn-outline" onclick="document.getElementById('arrivalModal').style.display='none'">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openArrivalModal(allocId, name, reqPosId) {
    document.getElementById('modalAllocId').value = allocId;
    document.getElementById('modalWorkerName').textContent = name;
    document.getElementById('arrivalModal').style.display = 'flex';
}

function checkPositionChange(select) {
    // If selected position differs, show reason box
    document.getElementById('posReasonGroup').style.display = 'block';
}
</script>

<!-- HR Action: Assign Workers (HR / ADMIN only) -->
<% if (user.role === 'HR' || user.role === 'ADMIN') { %>
    <div class="card mb-3" style="border: 2px solid var(--color-primary);">
        <div class="card-header" style="background: rgba(27,42,74,0.05);">
            <h3>🤝 HR Worker Allocation</h3>
            <span class="text-sm text-muted">Assign candidates or register incoming workers for deployment</span>
        </div>
        <div class="card-body">
            <form action="/manpower/<%= request.id %>/allocate" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="request_position_id">For Requested Position Slot <span class="required">*</span></label>
                    <select id="request_position_id" name="request_position_id" class="form-control" required>
                        <% requestedPositions.forEach(p => { %>
                            <option value="<%= p.id %>"><%= p.position_title %> (Needs <%= p.quantity_requested %>)</option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Worker Sourcing Method</label>
                        <div style="display: flex; gap: 16px; margin-top: 8px;">
                            <label class="form-check" style="cursor: pointer;">
                                <input type="radio" name="worker_type" value="new" checked onclick="toggleWorkerSource('new')">
                                <span>Incoming / External Candidate</span>
                            </label>
                            <label class="form-check" style="cursor: pointer;">
                                <input type="radio" name="worker_type" value="existing" onclick="toggleWorkerSource('existing')">
                                <span>Existing Employee Transfer</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group" id="incomingWorkerGroup">
                    <label for="worker_name">Candidate Full Name <span class="required">*</span></label>
                    <input type="text" id="worker_name" name="worker_name" class="form-control" placeholder="e.g. Rolando Bautista">
                </div>

                <div class="form-group" id="existingEmployeeGroup" style="display: none;">
                    <label for="existing_employee_id">Select Existing Employee</label>
                    <select id="existing_employee_id" name="existing_employee_id" class="form-control">
                        <option value="">— Select Employee —</option>
                        <% availableEmployees.forEach(emp => { %>
                            <option value="<%= emp.id %>"><%= emp.full_name %> (<%= emp.employee_id %>)</option>
                        <% }) %>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Assign Candidate to Request
                </button>
            </form>
        </div>
    </div>

    <script>
    function toggleWorkerSource(type) {
        document.getElementById('incomingWorkerGroup').style.display = type === 'new' ? 'block' : 'none';
        document.getElementById('existingEmployeeGroup').style.display = type === 'existing' ? 'block' : 'none';
    }
    </script>
<% } %>

<!-- Communication Thread -->
<div class="card mb-3">
    <div class="card-header">
        <h3>💬 Communication Thread (<%= entries.length %>)</h3>
    </div>
    <div class="card-body">
        <div class="thread">
            <% entries.forEach(entry => { %>
                <div class="thread-entry">
                    <div class="thread-avatar <%= entry.author_role.toLowerCase() %>">
                        <%= entry.author_name ? entry.author_name.charAt(0).toUpperCase() : 'S' %>
                    </div>
                    <div class="thread-content">
                        <div class="thread-meta">
                            <span class="thread-author"><%= entry.author_name || 'System' %></span>
                            <span class="thread-role <%= entry.author_role.toLowerCase() %>"><%= entry.author_role %></span>
                            <span class="thread-time">• <%= formatDateTime(entry.created_at) %></span>
                        </div>
                        <div class="thread-body <%= entry.entry_type === 'system' ? 'thread-status-change' : '' %>"><%= entry.content %></div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div style="border-top: 2px solid var(--color-gray-200); padding-top: 20px; margin-top: 20px;">
            <form action="/manpower/<%= request.id %>/reply" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <textarea name="content" class="form-control" rows="2" placeholder="Post message or update on deployment..." required></textarea>
                </div>
                <button type="submit" class="btn btn-outline">Post Message</button>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>
