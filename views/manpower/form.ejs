<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Submit Manpower Request</h2>
        <div class="breadcrumb">
            <a href="/manpower">Manpower Requests</a>
            <span>/</span>
            <span>New Request</span>
        </div>
    </div>
</div>

<div style="max-width: 800px;">
    <div class="card">
        <div class="card-body">
            <form action="/manpower" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-row">
                    <div class="form-group">
                        <label for="area_id">Warehouse / Area <span class="required">*</span></label>
                        <% if (user.role === 'COORDINATOR') { %>
                            <input type="hidden" name="area_id" value="<%= userAreaId %>">
                            <input type="text" class="form-control" value="<%= userArea ? userArea.name : '' %>" readonly disabled>
                        <% } else { %>
                            <select id="area_id" name="area_id" class="form-control" required>
                                <% areas.forEach(a => { %>
                                    <option value="<%= a.id %>"><%= a.name %></option>
                                <% }) %>
                            </select>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="deployment_date">Required Term Deployment Date <span class="required">*</span></label>
                        <input type="date" id="deployment_date" name="deployment_date" class="form-control" 
                               value="<%= new Date(Date.now() + 86400000).toISOString().split('T')[0] %>" required>
                    </div>
                </div>

                <!-- Position Breakdown -->
                <div class="form-group">
                    <label>Requested Positions & Number of Workers Needed <span class="required">*</span></label>
                    <div style="background: var(--color-gray-50); border: 1px solid var(--color-gray-300); border-radius: 6px; padding: 14px;">
                        <% positions.forEach(p => { %>
                            <div style="display: flex; align-items: center; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--color-gray-200);">
                                <div>
                                    <strong><%= p.title %></strong>
                                    <% if (p.description) { %>
                                        <div class="text-xs text-muted"><%= p.description %></div>
                                    <% } %>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="text-sm">Qty:</span>
                                    <input type="number" name="positions[p_<%= p.id %>]" class="form-control" min="0" max="100" value="0" style="width: 80px; text-align: center;">
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="priority">Priority Level</label>
                        <select id="priority" name="priority" class="form-control">
                            <option value="normal">Normal</option>
                            <option value="high">High</option>
                            <option value="urgent">Urgent</option>
                            <option value="low">Low</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="shift_details">Shift Schedule</label>
                        <input type="text" id="shift_details" name="shift_details" class="form-control" placeholder="e.g. 08:00 - 17:00 Day Shift">
                    </div>
                </div>

                <div class="form-group">
                    <label for="reason">Reason for Request <span class="required">*</span></label>
                    <input type="text" id="reason" name="reason" class="form-control" placeholder="e.g. Peak season volume surge, warehouse inventory audit" required>
                </div>

                <div class="form-group">
                    <label for="remarks">Additional Instructions / Qualifications</label>
                    <textarea id="remarks" name="remarks" class="form-control" rows="3" placeholder="Special requirements like forklift certification or safety gear..."></textarea>
                </div>

                <div class="d-flex gap-1" style="margin-top: 24px;">
                    <button type="submit" class="btn btn-primary btn-lg">Submit Manpower Request</button>
                    <a href="/manpower" class="btn btn-outline btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>
