<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Employee Concern: <%= concern.employee_name %></h2>
        <div class="breadcrumb">
            <a href="/concerns">Requests & Concerns</a>
            <span>/</span>
            <span>Employee Concerns</span>
            <span>/</span>
            <span>Case #<%= concern.id %></span>
        </div>
    </div>
    <div>
        <%- include('../partials/status-badge', { status: concern.status }) %>
    </div>
</div>

<!-- Concern Overview Card -->
<div class="detail-grid card mb-3" style="padding: 20px;">
    <div class="detail-item">
        <div class="detail-label">Subject Employee</div>
        <div class="detail-value">
            <a href="/employees/<%= concern.employee_id %>"><%= concern.employee_name %> (<%= concern.emp_code %>)</a>
        </div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Warehouse / Area</div>
        <div class="detail-value"><%= concern.area_name %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Concern Category</div>
        <div class="detail-value"><strong style="color: var(--color-primary);"><%= concern.category %></strong></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Reporting Coordinator</div>
        <div class="detail-value"><%= concern.reported_by_name || 'Coordinator' %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Date Reported</div>
        <div class="detail-value"><%= formatDateTime(concern.created_at) %></div>
    </div>
</div>

<% if (canViewDecision) { %>
<section class="card mb-3" id="hr-decision" aria-labelledby="hr-decision-title" style="scroll-margin-top: 90px;">
    <div class="card-header"><h3 id="hr-decision-title">HR Decision</h3></div>
    <div class="card-body">
        <% const latestDecision = decisions[0]; %>
        <% if (latestDecision) { %>
            <dl class="detail-grid">
                <div><dt class="detail-label">Policy or Article Violated</dt><dd><%= latestDecision.policy_violation %></dd></div>
                <div><dt class="detail-label">Sanction or HR Action</dt><dd><%= latestDecision.sanction %></dd></div>
                <div><dt class="detail-label">Employee Work Status</dt><dd><%= latestDecision.work_status %></dd></div>
            </dl>
            <p class="text-muted">Recorded by <%= latestDecision.decided_by_name %> on <%= formatDateTime(latestDecision.created_at) %></p>
        <% } else { %>
            <p class="text-muted">No HR decision has been recorded.</p>
        <% } %>
        <% if (decisions.length > 1) { %>
            <details class="mb-3">
                <summary>Previous decisions (<%= decisions.length - 1 %>)</summary>
                <ul>
                    <% decisions.slice(1).forEach(decision => { %>
                        <li>
                            <strong><%= formatDateTime(decision.created_at) %> · <%= decision.decided_by_name %></strong>
                            <dl>
                                <dt>Policy or Article Violated</dt><dd><%= decision.policy_violation %></dd>
                                <dt>Sanction or HR Action</dt><dd><%= decision.sanction %></dd>
                                <dt>Employee Work Status</dt><dd><%= decision.work_status %></dd>
                            </dl>
                        </li>
                    <% }); %>
                </ul>
            </details>
        <% } %>
        <% if (user.role === 'HR') { %>
            <details <%= latestDecision ? '' : 'open' %>>
                <summary><%= latestDecision ? 'Record a new decision' : 'Record decision' %></summary>
                <form action="/concerns/<%= concern.id %>/decision" method="POST" class="mt-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group">
                        <label for="policy_violation">Policy or Article Violated</label>
                        <textarea id="policy_violation" name="policy_violation" class="form-control" rows="2" maxlength="255" placeholder="Enter the policy or type No violation found" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="sanction">Sanction or HR Action</label>
                        <textarea id="sanction" name="sanction" class="form-control" rows="2" maxlength="255" placeholder="Enter the action or type No action" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="work_status">Employee Work Status</label>
                        <textarea id="work_status" name="work_status" class="form-control" rows="2" maxlength="255" placeholder="Enter the work status and any applicable dates" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Decision and Notify Coordinator</button>
                </form>
            </details>
        <% } %>
    </div>
</section>
<% } %>

<!-- Thread & Follow-ups -->
<div class="card mb-3">
    <div class="card-header">
        <h3>💬 Thread & HR Instructions (<%= entries.length %>)</h3>
    </div>
    <div class="card-body">
        <div class="thread">
            <% entries.forEach(entry => { %>
                <div class="thread-entry">
                    <div class="thread-avatar <%= entry.author_role.toLowerCase() %>">
                        <%= entry.author_name ? entry.author_name.charAt(0).toUpperCase() : 'S' %>
                    </div>
                    <div class="thread-content">
                        <div class="thread-meta">
                            <span class="thread-author"><%= entry.author_name || 'System' %></span>
                            <span class="thread-role <%= entry.author_role.toLowerCase() %>"><%= entry.author_role %></span>
                            <span class="thread-time">• <%= formatDateTime(entry.created_at) %></span>
                        </div>
                        <div class="thread-body <%= entry.entry_type === 'instruction' ? 'thread-status-change' : '' %>" style="<%= entry.entry_type === 'instruction' ? 'border-left-color: var(--color-accent); font-style: normal;' : '' %>">
                            <% if (entry.entry_type === 'instruction') { %>
                                <strong style="color: var(--color-accent); display: block; margin-bottom: 4px;">HR Instruction / Directive:</strong>
                            <% } %>
                            <%= entry.content %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Add Reply Form -->
        <div style="border-top: 2px solid var(--color-gray-200); padding-top: 20px; margin-top: 20px;">
            <h4 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--color-primary);">Add Update or Directive</h4>
            <form action="/concerns/<%= concern.id %>/reply" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <textarea name="content" class="form-control" rows="3" placeholder="<%= user.role === 'COORDINATOR' ? 'Post coordinator follow-up, meeting notes, or employee updates...' : 'Provide specific HR instructions or guidance...' %>" required></textarea>
                </div>

                <% if (user.role === 'HR' || user.role === 'ADMIN') { %>
                    <div class="form-group">
                        <label for="new_status">Update Status (Optional)</label>
                        <select name="new_status" id="new_status" class="form-control" style="max-width: 300px;">
                            <option value="">Keep current status (<%= concern.status.replace(/_/g, ' ') %>)</option>
                            <option value="under_review">Mark as: Under Review</option>
                            <option value="for_employee_reporting">Mark as: For Employee Reporting</option>
                            <option value="resolved">Mark as: Resolved</option>
                        </select>
                    </div>
                <% } %>

                <button type="submit" class="btn btn-primary">
                    Post Message
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>
